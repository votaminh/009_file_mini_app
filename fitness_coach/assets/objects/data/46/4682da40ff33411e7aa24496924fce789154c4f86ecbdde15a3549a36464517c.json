{"name":"\ub354 \ub864","introduce":"\uc591\ud314\uc744 \uc88c\uc6b0\ub85c \ubed7\uace0 \ubc14\ub85c \ub204\uc6cc\uc11c \uc2dc\uc791\ud569\ub2c8\ub2e4. \\n\\n\uac00\uc2b4\uc744 \ud5a5\ud574 \ubb34\ub98e\uc744 \uad7d\ud788\uace0, \uc591 \ub2e4\ub9ac\ub97c \ucc9c\uc815\uc744 \ud5a5\ud574 \ub4e4\uc5b4\uc62c\ub9bd\ub2c8\ub2e4. \ub2e4\ub9ac\ub97c \ub0b4\ub9b0 \ub2e4\uc74c \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":10,"text":"\ub9e4\ud2b8\ub97c \uc900\ube44\ud574 \uc8fc\uc138\uc694."},{"type":0,"text":"\ub4f1 \uc544\ub798 \ubd80\ubd84\uc744 \ubc14\ub2e5\uc5d0 \ubc00\ucc29\uc2dc\ud0a4\uc138\uc694."},{"type":0,"text":"\uc591 \ub2e4\ub9ac\ub294 \ud56d\uc0c1 \uc11c\ub85c \ubd99\uc774\uc138\uc694."},{"type":0,"text":"\ub4f1 \uc544\ub798\ub97c \uad7d\ud788\uc9c0 \ub9c8\uc138\uc694."},{"type":0,"text":"\uc591\ubc1c\uc740 \ubc14\ub2e5\uc5d0 \ub2ff\uc9c0 \uc54a\uac8c \ud558\uc138\uc694."},{"type":4,"text":"\ub2e4\ub9ac\ub97c \ub0b4\ub9b4 \ub54c \uc228\uc744 \ub4e4\uc774\uc26c\uace0 \ub4e4\uc5b4\uc62c\ub9b4 \ub54c \ub0b4\uc26c\uc138\uc694."},{"type":0,"text":"\ud558\ubcf5\uadfc\uc5d0 \uc5f4\uc774 \uc624\ub974\ub294 \ub290\ub08c\uc744 \ubc1b\uc544\uc57c \ud569\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ubcf5\uadfc\uc744 \ub2e8\ub828\uc2dc\ud0b5\ub2c8\ub2e4."}]}