{"name":"\uc2a4\ud30c\uc774\ub354\ub9e8 \ud50c\ub7ad\ud06c","introduce":"\ubc14\ub2e5\uc5d0 \ub611\ubc14\ub85c \ub204\uc6cc \ubc1c\uac00\ub77d\uacfc \ud314\ub69d\uc744 \ubc14\ub2e5\uc5d0 \ub0b4\ub824 \ub193\uc73c\uc138\uc694. \ubab8\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694.\\n\\n\uc67c\ucabd \ubb34\ub98e\uc744 \uad7d\ud600 \uc67c\ud314\uc758 \ubc14\uae65 \ubd80\ubd84\uc5d0 \uac00\uc838\uc624\uc138\uc694. \uc2dc\uc791 \uc704\uce58\ub85c \ub3cc\uc544\uac00 \ub2e4\ub978\ucabd \ub2e4\ub9ac\ub85c \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c\ud569\ub2c8\ub2e4."},{"type":0,"text":"\ubab8\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ubc30\ub97c \uaf49 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\ud799\uc744 \uc544\ub798\ub85c \ub0b4\ub9ac\uac70\ub098 \ub4e4\uc5b4 \uc62c\ub9ac\uc9c0 \ub9c8\uc138\uc694."},{"type":0,"text":"\ub4e4\uc5b4\uc62c\ub9b0 \ubb34\ub98e\uc744 \ucd5c\ub300\ud55c \ud314 \ubc16\uc5d0 \uac00\uae5d\uac8c \uac00\uc838\uc624\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ucf54\uc5b4\uc640 \uc5b4\uae68\ub97c \uac15\ud654\uc2dc\ucf1c\uc90d\ub2c8\ub2e4."},{"type":4,"text":"\ubb34\ub98e\uc744 \uad7d\ud790 \ub54c \ub0b4\uc26c\uace0, \ud50c\ub7ad\ud06c \uc790\uc138\ub85c \ub3cc\uc544\uac08 \ub54c \ub4e4\uc774\ub9c8\uc2ed\ub2c8\ub2e4."}]}