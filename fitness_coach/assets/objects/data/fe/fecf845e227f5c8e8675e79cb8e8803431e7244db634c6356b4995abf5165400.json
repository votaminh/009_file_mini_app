{"name":"\ud50c\ub7ad\ud06c \uc7ad","introduce":"\ub450 \uc190\uc744 \uc5b4\uae68 \ubc11\uc5d0 \ub193\uace0 \ub450 \ubc1c\uc740 \ubd99\uc778\ucc44 \ud314\uc744 \ucb49 \ud3b8 \ud50c\ub7ad\ud06c \uc790\uc138\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4.\\n\ub450 \ubc1c\uc744 \uc810\ud504\ud558\ub4ef \ub5bc\uc5b4\ub0b4\uba70 \ubc1c\uac00\ub77d\uc73c\ub85c \ucc29\ub959\ud588\ub2e4\uac00 \ub2e4\uc2dc \uc2dc\uc791 \uc704\uce58\ub85c \uc810\ud504\ud569\ub2c8\ub2e4. \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud558\uc138\uc694."},{"type":0,"text":"\uc0c1\uccb4\ub97c \uc548\uc815\ub418\uac8c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ubab8\uc774 \uc77c\uc790\uc5ec\uc57c\ud569\ub2c8\ub2e4."},{"type":0,"text":"\uc5c9\ub369\uc774\ub97c \ub0b4\ub9ac\uac70\ub098 \uc62c\ub9ac\uba74 \uc548\ub429\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ubcf5\uadfc, \ucf54\uc5b4, \uc5b4\uae68, \uadf8\ub9ac\uace0 \ud5c8\ub9ac\uc5d0 \uc88b\uc2b5\ub2c8\ub2e4."}]}