{"name":"\uc67c\ubb34\ub98e \ub4e4\uc5b4\uc62c\ub9ac\uae30","introduce":"\ub4f1\uc744 \ub611\ubc14\ub85c \uc138\uc6b0\uace0 \uc758\uc790\uc5d0 \uc549\uc740 \uc0c1\ud0dc\ub85c \ud558\uc138\uc694. \uc67c\ucabd \ubb34\ub98e\uc744 \ucc9c\ucc9c\ud788 \ub611\ubc14\ub85c \ub4e4\uc5b4 \uc62c\ub9b0 \ub2e4\uc74c \ucc9c\ucc9c\ud788 \ub0b4\ub9ac\uc138\uc694.","tips":[{"type":18,"text":"\uc758\uc790\ub97c \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\ub4f1\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\uc774 \uc6b4\ub3d9\uc740 \ucc9c\ucc9c\ud788 \uc9c4\ud589\ud558\uc2dc\uace0, \ubc18\ub3d9\uc744 \uc774\uc6a9\ud558\uc9c0 \ub9c8\uc138\uc694."},{"type":0,"text":"\uc6b4\ub3d9 \uc911\uc5d0 \uc55e\ub4a4\ub85c \uae30\ub300\uc9c0 \ub9c8\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uace0\uad00\uc808 \uad74\uace1\uadfc\uc744 \uac15\ud654\uc2dc\ucf1c\uc90d\ub2c8\ub2e4."}]}