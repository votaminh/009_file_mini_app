{"name":"\ud06c\ub85c\uc2a4 \ubb34\ub98e \ud50c\ub7ad\ud06c","introduce":"\ud50c\ub7ad\ud06c \uc790\uc138\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4. \ud55c \ucabd \ubb34\ub98e\uacfc \ubc18\ub300\ucabd \ud314\uafc8\uce58\uac00 \uc11c\ub85c \ub2ff\uac8c \ud588\ub2e4\uac00 \uc6d0 \uc704\uce58\ub85c \ub3cc\uc544\uac00\uc138\uc694. \ub2e4\ub978 \ucabd\uc73c\ub85c \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c\ud569\ub2c8\ub2e4."},{"type":0,"text":"\ud314\uafc8\uce58\uac00 \uc5b4\uae68 \ubc14\ub85c \ubc11\uc5d0 \uc624\ub3c4\ub85d \ud558\uc138\uc694."},{"type":0,"text":"\ubab8\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ud56d\uc0c1 \ubcf5\uadfc\uc744 \uc0ac\uc6a9\ud574\uc57c\ud569\ub2c8\ub2e4."},{"type":2,"text":"\ubcf5\uadfc, \uc0ac\uadfc \uadf8\ub9ac\uace0 \uc5c9\ub369\uc774 \uad74\uadfc\uc744 \uac15\ud654\uc2dc\ucf1c\uc90d\ub2c8\ub2e4."}]}