{"name":"V-\ud640\ub4dc","introduce":"\ubc14\ub2e5\uc5d0 \uc549\uc544 \ub2e4\ub9ac\ub97c 45\ub3c4 \uac01\ub3c4\ub85c \ub4e4\uc5b4 \uc62c\ub9bd\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \uc0c1\uccb4\ub97c 45\ub3c4 \uac01\ub3c4\ub85c \ub4a4\ub85c \uae30\uc6b8\uc785\ub2c8\ub2e4. \ub450 \ud314\uc744 \uc55e\uc73c\ub85c \ucb49 \ud3b4\uc138\uc694. \uc774 \uc790\uc138\ub97c \uc720\uc9c0\ud558\uc138\uc694.\\n\\n\ud638\ud761\uc744 \uba48\ucd94\uc9c0 \ub9c8\uc138\uc694. \ud638\ud761\uc740 \ud3c9\uc0c1\uc2dc\ucc98\ub7fc, \uac00\uc2b4\uc774 \uc544\ub2c8\ub77c \ubc30\ub85c \ud558\uc138\uc694.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c\ud569\ub2c8\ub2e4."},{"type":0,"text":"\ub2e4\ub9ac\ub97c \ucd5c\ub300\ud55c \uace7\uac8c \ubed7\uc73c\uc138\uc694."},{"type":0,"text":"\ub4f1\uc744 \ub465\uae00\uac8c \ub9cc\ub4e4\uc9c0 \ub9c8\uc138\uc694."},{"type":4,"text":"\uc815\uc0c1\uc801\uc73c\ub85c \ud638\ud761\ud558\uc138\uc694."},{"type":0,"text":"\uc6b4\ub3d9\uc744 \ub354 \uc27d\uac8c \ub9cc\ub4e4\uace0 \uc2f6\uc73c\uba74 \ubc1c\uc744 \ubc14\ub2e5\uc5d0 \ub0b4\ub824 \ub193\uc73c\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ubcf5\uc9c1\uadfc\uacfc \uc0ac\uadfc\uc744 \uac15\ud654\uc2dc\ucf1c\uc90d\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ucf54\uc5b4 \uadfc\ub825\uc744 \uac15\ud654\ud569\ub2c8\ub2e4."}]}