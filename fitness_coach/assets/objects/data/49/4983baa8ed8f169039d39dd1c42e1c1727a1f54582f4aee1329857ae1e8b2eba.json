{"name":"\uc8fd\uc740 \uace4\ucda9 \uc790\uc138","introduce":"\ub611\ubc14\ub85c \ub204\uc6cc \ubb34\ub98e\uc744 90\ub3c4 \uac01\ub3c4\ub85c \uad7d\ud600 \ub4e4\uc5b4\uc62c\ub9ac\uace0 \ub450 \ud314\uc744 \ud558\ub298\uc744 \ud5a5\ud574 \ucb49 \ubed7\uc73c\uc138\uc694.\\n\\n\uc624\ub978\ucabd \ub2e4\ub9ac\ub97c \ub0b4\ub9ac\uba70 \ub3d9\uc2dc\uc5d0 \uc67c\ucabd \ud314\uc744 \uba38\ub9ac \uc704\ub85c \ubed7\uc73c\uc138\uc694.\\n\\n1\ucd08 \ub3d9\uc548 \uadf8 \uc790\uc138\ub97c \uc720\uc9c0\ud588\ub2e4\uac00 \uc2dc\uc791 \uc704\uce58\ub85c \ub3cc\uc544\uc624\uc138\uc694. \ubc18\ub300\ucabd\uc73c\ub85c \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c\ud569\ub2c8\ub2e4."},{"type":0,"text":"\ub4f1\uc744 \ud56d\uc0c1 \ubc14\ub2e5\uc5d0 \ud3c9\ud3c9\ud558\uac8c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ub4f1\uc744 \uad6c\ubd80\ub9ac\uc9c0 \ub9c8\uc138\uc694."},{"type":0,"text":"\ub108\ubb34 \uc5b4\ub824\uc6b4\uac00\uc694? \ud314\uc774\ub098 \ub2e4\ub9ac\ub97c \uadf8\ub0e5 \ucb49 \ud3b4\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ud5c8\ub9ac \ud1b5\uc99d\uc744 \uc644\ud654\ud558\ub294\ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"type":4,"text":"\ud314\uacfc \ubc18\ub300\ucabd \ub2e4\ub9ac\ub97c \uc62c\ub9b4 \ub54c \ub4e4\uc774\ub9c8\uc2dc\uace0, \ub0b4\ub9b4 \ub54c \ub0b4\uc27d\ub2c8\ub2e4."}]}