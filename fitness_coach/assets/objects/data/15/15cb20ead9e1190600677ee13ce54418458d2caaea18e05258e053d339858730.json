{"name":"\ud504\ub85c\uae30 \uae00\ub8e8\ud2b8 \ub9ac\ud504\ud2b8","introduce":"\ub2e4\ub9ac\ub97c \ud568\uaed8 \ubaa8\uc73c\uace0 \ub2f4\uc694 \uc704\uc5d0\uc11c \uc2dc\uc791\ud569\ub2c8\ub2e4. \\n\\n\ubc1c\uc744 \uace7\uac8c \ud3b4\uace0 \uc704\uc544\ub798\ub85c \uc62c\ub838\ub2e4 \ub0b4\ub9bd\ub2c8\ub2e4. \uc5c9\ub369\uc774\ub97c \uc555\ubc15\ud558\ub294 \ub370 \uad49\uc7a5\ud788 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\uc911\ucd94\ub97c \ud56d\uc0c1 \uc0ac\uc6a9\ud558\uc138\uc694."},{"type":0,"text":"\ub2e4\ub9ac\ub97c \uc62c\ub9b4 \ub54c \ub454\uadfc\uc758 \ud798\uc744 \uc0ac\uc6a9\ud558\uc138\uc694."},{"type":0,"text":"\ubc1c\uc744 \uc62c\ub9b4 \ub54c \uc0c1\uccb4\ub97c \uac19\uc774 \uc62c\ub9ac\uba74 \uc548\ub429\ub2c8\ub2e4."},{"type":0,"text":"\ubc1c\uc744 \uc62c\ub9b4 \ub54c \uc228\uc744 \ub0b4\uc26c\uace0, \ub0b4\ub9b4 \ub54c \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uc138\uc694."},{"type":0,"text":"\ub454\uadfc\uc774 \ud0c0\ub294 \ub4ef\uc774 \ub290\uaef4\uc838\uc57c \ud569\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc5c9\ub369\uc774\ub97c \uc9d1\uc911\uacf5\uaca9\ud569\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ud5c8\ub9ac\uc5d0 \uc88b\uc2b5\ub2c8\ub2e4."}]}