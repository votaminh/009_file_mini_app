{"name":"\u041f\u0440\u044b\u0436\u043a\u0438 \u043d\u0430 \u043a\u043e\u0440\u0442\u043e\u0447\u043a\u0430\u0445","introduce":"\u041f\u0440\u0438\u0441\u0435\u0432 \u043d\u0430 \u043a\u043e\u0440\u0442\u043e\u0447\u043a\u0438, \u043f\u043e\u0434\u043f\u0440\u044b\u0433\u043d\u0438\u0442\u0435 \u0437\u0430 \u0441\u0447\u0435\u0442 \u043c\u044b\u0448\u0446 \u0436\u0438\u0432\u043e\u0442\u0430. \u041f\u0440\u0438\u0437\u0435\u043c\u043b\u044f\u044f\u0441\u044c, \u043f\u0440\u0438\u043c\u0438\u0442\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u00ab\u043d\u0430 \u043a\u043e\u0440\u0442\u043e\u0447\u043a\u0430\u0445\u00bb. \\n\\n\u041e\u0442\u043b\u0438\u0447\u043d\u043e\u0435 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0440\u0430\u0437\u043e\u0433\u0440\u0435\u0432\u0430 \u043f\u0435\u0440\u0435\u0434 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043e\u043c \u0434\u043b\u044f \u043f\u0440\u0435\u0441\u0441\u0430.","tips":[{"type":0,"text":"\u041d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439\u0442\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0441\u0438\u043b\u0443 \u043f\u0440\u0435\u0441\u0441\u0430."},{"type":0,"text":"\u041a\u043e\u043b\u0435\u043d\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0442\u0443\u0434\u0430 \u0436\u0435, \u043a\u0443\u0434\u0430 \u0438 \u043d\u043e\u0441\u043a\u0438."},{"type":0,"text":"\u0412 \u043f\u0440\u0438\u0441\u0435\u0434\u0435 \u0433\u0440\u0443\u0434\u044c \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u0432\u044b\u0448\u0435 \u0431\u0451\u0434\u0435\u0440."},{"type":0,"text":"\u0421\u043c\u044f\u0433\u0447\u0430\u0439\u0442\u0435 \u043f\u0440\u0438\u0437\u0435\u043c\u043b\u0435\u043d\u0438\u0435 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043c\u044b\u0448\u0446."},{"type":0,"text":"\u0412 \u043f\u0440\u0438\u0441\u0435\u0434\u0435 \u043a\u043e\u043b\u0435\u043d\u0438 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u0432\u044b\u0445\u043e\u0434\u0438\u0442\u044c \u0432\u043f\u0435\u0440\u0451\u0434 \u0434\u0430\u043b\u044c\u0448\u0435 \u043d\u043e\u0441\u043a\u043e\u0432."},{"type":0,"text":"\u041e\u043f\u0443\u0441\u043a\u0430\u0439\u0442\u0435\u0441\u044c \u043d\u0430 \u0432\u0434\u043e\u0445\u0435, \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0439\u0442\u0435\u0441\u044c \u043d\u0430 \u0432\u044b\u0434\u043e\u0445\u0435."},{"type":0,"text":"\u0415\u0441\u043b\u0438 \u0412\u0430\u043c \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043b\u0435\u0433\u043a\u043e, \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435 \u0440\u0443\u043a\u0438 \u0437\u0430 \u0433\u043e\u043b\u043e\u0432\u0443."},{"type":0,"text":"\u0427\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0435 \u0442\u044f\u0436\u0435\u043b\u0435\u0435, \u043f\u0440\u0438 \u0432\u044b\u043f\u0440\u044b\u0433\u0438\u0432\u0430\u043d\u0438\u0438 \u0441\u0432\u043e\u0434\u0438\u0442\u0435 \u043d\u043e\u0433\u0438 \u0432\u043c\u0435\u0441\u0442\u0435."},{"type":0,"text":"\u0421\u043b\u0438\u0448\u043a\u043e\u043c \u043b\u0435\u0433\u043a\u043e? \u041f\u0440\u0438 \u0432\u044b\u043f\u0440\u044b\u0433\u0438\u0432\u0430\u043d\u0438\u0438 \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0439\u0442\u0435 \u043a\u043e\u043b\u0435\u043d\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0432\u044b\u0441\u043e\u043a\u043e."},{"type":0,"text":"\u0415\u0441\u043b\u0438 \u0412\u0430\u043c \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0442\u044f\u0436\u0435\u043b\u043e, \u043f\u043e\u043c\u043e\u0433\u0430\u0439\u0442\u0435 \u0441\u0435\u0431\u0435 \u0432\u044b\u043f\u0440\u044b\u0433\u0438\u0432\u0430\u0442\u044c \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0440\u0443\u043a."},{"type":2,"text":"\u0425\u043e\u0440\u043e\u0448\u0435\u0435 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u043d\u043e\u0433 \u0438 \u044f\u0433\u043e\u0434\u0438\u0446."}]}