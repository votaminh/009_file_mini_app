{"name":"\uc624\ud504\uc14b \ud478\uc2dc\uc5c5","introduce":"\ud55c \uc190\uc740 \ub545\uc5d0 \ubc18\ub300 \uc190\uc740 \uc57d\uac04 \ub192\uc740 \ub2e8 \uac19\uc740 \uacf3\uc5d0 \uc62c\ub9ac\uace0 \ud478\uc2dc\uc5c5 \uc790\uc138\ub97c \uc2dc\uc791\ud569\ub2c8\ub2e4.\\n\\n\ud478\uc2dc\uc5c5\uc744 \ud558\uace0, \uc190\uc73c\ub85c \ub118\uace0 \ubc29\ud5a5\uc744 \ubc14\uafc9\ub2c8\ub2e4. \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":30,"text":"\ud50c\ub7ab\ud3fc\uc774\ub098 \uc774\uc640 \ube44\uc2b7\ud55c \ubb3c\uac74\uc744 \uc900\ube44\ud558\uc154\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ubab8\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ubab8\uc744 \ub0b4\ub9ac\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uace0, \ub2e4\uc2dc \uc62c\ub77c\uc624\uba70 \uc228\uc744 \ub0b4\uc26c\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uac00\uc2b4, \ubcf5\uadfc, \uc0bc\ub450\uadfc\uc744 \ub2e8\ub828\uc2dc\ud0b5\ub2c8\ub2e4."}]}