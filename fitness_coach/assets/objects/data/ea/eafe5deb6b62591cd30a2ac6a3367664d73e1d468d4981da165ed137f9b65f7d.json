{"name":"\uc544\ub839 \uccb4\uc5b4 \uc2a4\ud15d \uc5c5","introduce":"\uc591 \uc190\uc5d0 \uc544\ub839\uc744 \ub4e4\uace0 \uc591 \uc606\uc5d0 \ub454 \ucc44 \uc12d\ub2c8\ub2e4. \uc774 \uc6b4\ub3d9\uc740 \ub2e4\ub9ac\uc640 \uc5c9\ub369\uc774\ub97c \uac15\ud654, \uc758\uc790\uc5d0 \uc9c0\uc0c1 \uc2a4\ud15d \uc5c5 \ub5a8\uc5b4\uc838 \ubab8\uc744 \ub4e4\uc5b4 \uc62c\ub824 \uc758\uc790\uc5d0 \ud55c \ubc1c\uc744 \ub193\uc2b5\ub2c8\ub2e4.","tips":[{"type":17,"text":"2\uac1c\uc758\uc544\ub839\uc744 \uc900\ube44\ud558\uc138\uc694."},{"type":18,"text":"\uc758\uc790\ub97c \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\ud55c \ubc1c \uc804\uccb4\ub97c \uc758\uc790 \uc704\uc5d0 \uc62c\ub824 \ub193\uc73c\uc138\uc694."},{"type":0,"text":"\ub4f1\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\uc758\uc790 \uc704\ub85c \uc62c\ub77c\uac00\uba70 \uc228\uc744 \ub0b4\uc26c\uace0, \ub2e4\uc2dc \ub0b4\ub824\uc624\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uc138\uc694."},{"type":0,"text":"\ub108\ubb34 \uc5b4\ub835\ub2e4\uace0 \ub290\uaef4\uc9c0\uba74 \ub354 \ub0ae\uc740 \uc758\uc790\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub2e4\ub9ac\uc640 \ub454\uadfc\uc5d0 \uc88b\uc2b5\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc911\uc2ec\uc744 \uc798 \uc7a1\uc744 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4."}]}