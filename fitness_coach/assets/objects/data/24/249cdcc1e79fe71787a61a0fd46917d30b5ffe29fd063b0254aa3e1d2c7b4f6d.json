{"name":"\ud06c\ub85c\uc2a4 \ud130\uce58 \ubed7\uae30","introduce":"\ub545\uc5d0 \ub611\ubc14\ub85c \uc11c\uc11c \ud314\uc744 \uc5b4\uae68 \ub192\uc774\ub85c \uc591\ucabd\uc73c\ub85c \ucb49 \ubed7\uc740 \uc0c1\ud0dc\ub85c \uc2dc\uc791\ud558\uc138\uc694.\\n\\n\ubab8\uc744 \uad7d\ud600 \uc67c\uc190\uc73c\ub85c \uc624\ub978\ucabd \ubc1c\uc744 \ud130\uce58\ud558\uac70\ub098 \ucd5c\ub300\ud55c \uac00\uae4c\uc774 \uac00\uc838\uac00\uc138\uc694. \ub2e4\ub978 \ucabd\uc73c\ub85c \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":0,"text":"\ubab8\uc744 \uad7d\ud790 \ub54c \ub4f1\uc744 \ub611\ubc14\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ubab8\uc744 90\ub3c4 \uac01\ub3c4\ub85c \uad7d\ud788\uc138\uc694."},{"type":0,"text":"\ubb34\ub98e\uc744 \uad7d\ud788\uc9c0 \ub9c8\uc138\uc694."},{"type":0,"text":"\ubab8\uc744 \uc219\uc774\uba70 \uc228\uc744 \ub0b4\uc26c\uace0, \ub2e4\uc2dc \uc62c\ub9ac\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uc138\uc694."},{"type":0,"text":"\ud314\uc774 \ud5c8\uacf5\uc5d0 \uc788\uc744 \ub54c \uc190\uac00\ub77d\uc5d0\uc11c \ubc1c\uac00\ub77d\uae4c\uc9c0 \ub2f9\uae40\uc744 \ub290\uaef4\uc57c\ud569\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc6cc\ubc0d\uc5c5\uc5d0 \ub3c4\uc6c0\uc774\ub429\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc624\uae08\uc904, \ubab8\ud1b5, \uadf8\ub9ac\uace0 \ud314\uc744 \uc2a4\ud2b8\ub808\uce6d \uc2dc\ucf1c\uc90d\ub2c8\ub2e4."}]}