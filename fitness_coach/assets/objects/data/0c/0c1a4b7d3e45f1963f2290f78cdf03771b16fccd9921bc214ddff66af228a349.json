{"name":"\uc549\uc544\uc11c \ubcf5\uadfc \uc2dc\uacc4 \ubc29\ud5a5\uc73c\ub85c \ub3cc\ub9ac\uae30","introduce":"\ubc14\ub2e5\uc5d0 \uc549\uc544 \uc190\ubc14\ub2e5\uc744 \uc5c9\ub369\uc774 \ub4a4, \uc591 \uc606\uc5d0 \ub461\ub2c8\ub2e4.\\n\\n\ub2e4\ub9ac\ub97c \ucb49 \ubed7\uc5b4 \ubc14\ub2e5\uc5d0\uc11c \ub4e4\uc5b4 \uc62c\ub9ac\uc138\uc694. \ub2e4\ub9ac\ub97c \uc2dc\uacc4 \ubc29\ud5a5\uc73c\ub85c \ub3cc\ub9ac\uc138\uc694.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c\ud569\ub2c8\ub2e4."},{"type":0,"text":"\uac00\uc2b4\uc744 \ub0b4\ubbfc \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ub2e4\ub9ac\ub97c \ud56d\uc0c1 \ubaa8\uc73c\uc138\uc694."},{"type":0,"text":"\ucf54\uc5b4\ub97c \ud56d\uc0c1 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\ub4f1\uc5d0 \ub108\ubb34 \ub9ce\uc740 \uc555\ub825\uc744 \ubc1b\uc73c\uba74 \uc548\ub429\ub2c8\ub2e4."},{"type":2,"text":"\ub0b4\ubd80 \ubc0f \uc678\ubd80 \uc0ac\uadfc\uc744 \uac15\ud654\uc2dc\ucf1c\uc90d\ub2c8\ub2e4."}]}