{"name":"\ub9c8\uc6b4\ud2f4 \ud074\ub77c\uc774\uba38","introduce":"\ud478\uc2dc\uc5c5 \uc790\uc138\uc5d0\uc11c, \ud55c \ucabd \ubb34\ub98e\uc744 \uac00\uc2b4\ucabd\uc73c\ub85c \uad6c\ubd80\ub9ac\uc138\uc694. \\n\\n\uac00\ubccd\uac8c \uc810\ud504\ud558\ub4ef \ub2e4\ub9ac\ub97c \ubc14\uafb8\uc5b4 \uad6c\ubd80\ub9bd\ub2c8\ub2e4. \uc774 \ub3d9\uc791\uc740 \uc804\uc2e0 \uadfc\uc721\uacfc \uc2ec\ud608\uad00\uc5d0 \uc88b\uc740 \uc601\ud5a5\uc744 \uc90d\ub2c8\ub2e4.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ubb34\ub98e\uc744 \ucd5c\ub300\ud55c \uac00\uae4c\uc774 \uac00\uc2b4\uc5d0 \uac00\uc838 \uc624\uc138\uc694."},{"type":0,"text":"\ud799\uc744 \uc704\ub85c \uc62c\ub9ac\uc9c0 \ub9c8\uc138\uc694."},{"type":4,"text":"\uafb8\uc900\ud558\uace0 \uae4a\uc740 \uc2ec\ud638\ud761\uc744 \ud558\uc138\uc694."},{"type":0,"text":"\ub108\ubb34 \uc27d\ub2e4\uace0 \ub290\uaef4\uc9c0\uba74, \ucd5c\ub300\ud55c \ube68\ub9ac \ud558\uc138\uc694."},{"type":0,"text":"\ub108\ubb34 \uc5b4\ub835\ub2e4\uace0 \ub290\uaef4\uc9c0\uba74 \ud3b8\ud55c \uc18d\ub3c4\ub85c \ud558\uc138\uc694."},{"type":0,"text":"\ub108\ubb34 \uc5b4\ub835\ub2e4\uace0 \ub290\uaef4\uc9c0\uba74 \uc190\uc744 \ubca4\uce58 \uc704\ub85c \uc62c\ub9ac\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc804\uc2e0\uc5d0 \uc88b\uc740 \uc6b4\ub3d9\uc785\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc2ec\ud608\uad00 \uc2dc\uc2a4\ud15c\uc744 \uac15\ud654\uc2dc\ucf1c \uc90d\ub2c8\ub2e4."}]}