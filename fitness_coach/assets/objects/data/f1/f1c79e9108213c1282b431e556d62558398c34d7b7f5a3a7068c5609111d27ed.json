{"name":"\ubc1c\uac00\ub77d \ud0ed","introduce":"\ub611\ubc14\ub85c \ub204\uc6cc \ubb34\ub98e\uc744 \uad7d\ud788\uace0 \ubc1c\uc740 \ubc14\ub2e5\uc5d0.\\n\\n\ub2e4\ub9ac\ub97c \ud14c\uc774\ube14 \uc0c1\ub2e8 \ud3ec\uc9c0\uc158\uc73c\ub85c \ub4e4\uc5b4 \uc62c\ub9ac\uace0 \uc67c\ucabd \ubc1c\uc744 \ubc14\ub2e5\ucabd\uc73c\ub85c \ub0b4\ub9ac\uc138\uc694. \ubc1c\uac00\ub77d\uc73c\ub85c \ubc14\ub2e5\uc744 \ud0ed\ud558\uace0 \ub2e4\uc2dc \ub2e4\ub9ac\ub97c \ub4e4\uc5b4 \uc62c\ub9ac\uc138\uc694. \ub2e4\ub978 \ucabd\uc73c\ub85c \ubc14\uafd4 \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":10,"text":"\ub9e4\ud2b8\ub97c \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\ub2e4\ub9ac\ub97c \ubc14\ub2e5\uc73c\ub85c \ub0b4\ub824 \ub193\uc744 \ub54c \ubb34\ub98e\uc744 \ud754\ub4e4\ub9ac\uc9c0 \uc54a\uac8c \uc720\uc9c0\ud558\uc138\uc694."},{"type":4,"text":"\ub2e4\ub9ac\ub97c \ub0b4\ub9ac\uba70 \uc228\uc744 \ub0b4\uc26c\uace0 \ub2e4\uc2dc \uc62c\ub9ac\uba70 \uc228\uc744 \ub4e4\uc774 \ub9c8\uc2dc\uc138\uc694."}]}