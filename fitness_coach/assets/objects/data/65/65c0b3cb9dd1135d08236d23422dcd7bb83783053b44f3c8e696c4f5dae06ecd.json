{"name":"\ud50c\ub7ad\ud06c \uc564\ub4dc \ub9ac\uce58","introduce":"\uc77c\ubc18 \ud50c\ub7ad\ud06c \ud3ec\uc9c0\uc158\uc73c\ub85c \uc2dc\uc791\ud558\uc138\uc694. \ud314\uc744 \ubc88\uac08\uc544 \uac00\uba70 \uc55e\uc73c\ub85c \ucb49 \ubed7\uc73c\uc138\uc694.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud558\uc138\uc694."},{"type":0,"text":"\uc6b4\ub3d9 \uc911 \ubab8\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ud314\uc744 \ucb49 \ubed7\uc744 \ub54c \ub454\uadfc\uc744 \uaf49 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\ubcf5\uadfc\uc744 \uacc4\uc18d\ud574\uc11c \uaf49 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\uc5c9\ub369\uc774\uac00 \ub0b4\ub824\uac00\uac70\ub098 \uc62c\ub77c\uac00\uc9c0 \uc54a\uac8c \uc8fc\uc758\ud558\uc138\uc694."},{"type":2,"text":"\uc774\uac83\uc740 \ubcf5\ubd80 \uadfc\uc721\uacfc \uc0bc\uac01\uadfc \uadfc\uc721\uc744 \uc704\ud55c \ud6cc\ub96d\ud55c \uc6b4\ub3d9\uc785\ub2c8\ub2e4."}]}