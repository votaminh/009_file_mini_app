{"name":"\ud50c\ub7ad\ud06c \ub2e4\ub9ac \uc62c\ub9ac\uae30","introduce":"\ud314\uc744 \uace7\uac8c \ud540 \ud50c\ub7ad\ud06c \uc704\uce58\uc5d0\uc11c \uc2dc\uc791\ud569\ub2c8\ub2e4. \ub2e4\ub9ac\ub97c \ubc88\uac08\uc544 \uc704\uc544\ub798\ub85c \uc62c\ub838\ub2e4\uac00 \ub0b4\ub9bd\ub2c8\ub2e4.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\uc911\ucd94\ub97c \uaf49 \uc870\uc774\uace0 \ub454\uadfc\uc744 \uc0ac\uc6a9\ud558\uc138\uc694."},{"type":0,"text":"\ubab8\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":4,"text":"\uae4a\uace0 \uafb8\uc900\ud55c \ud638\ud761\uc744 \ud558\uc138\uc694."},{"type":0,"text":"\ub354 \uc5b4\ub835\uac8c \ud558\ub824\uba74 \ub3d9\uc2dc\uc5d0 \ubc18\ub300\ucabd \ud314\uacfc \ub2e4\ub9ac\ub97c \ub4e4\uc5b4 \uc62c\ub9ac\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc5b4\uae68, \ubcf5\ubd80, \ub300\ud1f4 \uc0ac\ub450\uadfc, \ub454\uadfc, \uadf8\ub9ac\uace0 \ub4f1 \uc544\ub798 \ubd80\ubd84\uc774 \uc9d1\uc911\uacf5\uaca9\ud569\ub2c8\ub2e4."}]}