{"name":"\uc2dc\ud2f0\ub4dc \uc778 \uc564 \uc544\uc6c3","introduce":"\ubca4\uce58\uc5d0 \uc549\uc544\uc11c \uc591\uc190\uc73c\ub85c \ub4a4\ub97c \ubc1b\uce58\uace0 \ubca4\uce58\ub97c \uc7a1\uc740 \uc0c1\ud0dc\ub85c, \ubab8\uc744 \ub4a4\ub85c \uae30\uc6b8\uc785\ub2c8\ub2e4.\\n\\n\ubb34\ub98e\uc744 \uad6c\ubd80\ub9ac\uba74\uc11c \uc591\ucabd \ub2e4\ub9ac\ub97c \ub4e4\uace0, \ubb34\ub98e\uc744 \uac00\uc2b4 \ucabd\uc73c\ub85c \ub2f9\uae41\ub2c8\ub2e4. \ub2e4\ub9ac\ub97c \ud3c8\ub2e4\uac00 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":12,"text":"\ubca4\uce58\ub97c \uc900\ube44\ud558\uc138\uc694"},{"type":0,"text":"\ucf54\uc5b4\ub97c \ubc14\uc9dd \uc870\uc774\uc138\uc694."},{"type":0,"text":"\ub4f1\uc740 \uaf3f\uaf3f\ud558\uac8c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ud06c\ub7f0\uce58\ub97c \ud560 \ub54c\ub9c8\ub2e4 \ubcf5\uadfc\uc744 \uc870\uc5ec \uc8fc\uc138\uc694."},{"type":0,"text":"\ucc9c\ucc9c\ud788 \ud558\uba74\uc11c \ub2f9\uaca8\uc9c0\ub294 \ub290\ub08c\uc744 \ubc1b\ub3c4\ub85d \ud558\uc138\uc694."},{"type":0,"text":"\ubb34\ub98e\uc744 \uac00\uc2b4\uc73c\ub85c \ub2f9\uae30\uba74\uc11c \uc228\uc744 \ub0b4\uc26c\uace0, \ub2e4\ub9ac\ub97c \ud3bc \ub54c \ub4e4\uc774\uc26c\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ud558\ubcf5\ubd80 \uadfc\uc721\uc5d0 \uc9d1\uc911\ub429\ub2c8\ub2e4."}]}