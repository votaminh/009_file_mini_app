{"name":"\uc704\uc544\ub798 \ud50c\ub7ad\ud06c","introduce":"\ud314\uc744 \ucb49 \ud3b8 \ud50c\ub7ad\ud06c \ud3ec\uc9c0\uc158\uc73c\ub85c \uc2dc\uc791\ud558\uc138\uc694.\\n\\n\uc624\ub978\ud314\uc744 \uad7d\ud600 \ud314\ub69d\uc744 \ub545\uc5d0 \ub193\uace0 \ud314\uafc8\uce58\uac00 \uc5b4\uae68 \ubc11\uc5d0 \uc624\uac8c \ud558\uc138\uc694. \uc67c\ucabd \ud314\ub3c4 \uad7d\ud600 \uc77c\ubc18 \ud50c\ub7ad\ud06c \ud3ec\uc9c0\uc158\uc774 \ub418\uac8c \ud558\uc138\uc694.\\n\\n\ub2e4\uc2dc \uac70\uafb8\ub85c \ud314\uc744 \ucc28\ub840\ub85c \ud3b4 \uc2dc\uc791 \uc704\uce58\ub85c \ub3cc\uc544\uc624\uc138\uc694. \uc774 \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud558\uc138\uc694."},{"type":0,"text":"\ucf54\uc5b4\ub97c \uaf49 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\ub2e4\ub9ac\ub97c \uc77c\uc790\ub85c \ucb49 \ubed7\uc740 \uc790\uc138\ub97c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\uba38\ub9ac\uc640 \ubaa9, \ub4f1\ubf08\ub97c \uc77c\uc9c1\uc120\uc73c\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\uc5c9\ub369\uc774\ub97c \ub0b4\ub9ac\uac70\ub098 \ub4e4\uc5b4 \uc62c\ub9ac\uc9c0 \ub9c8\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ucf54\uc5b4, \ud314, \ub454\uadfc, \ud314\ubaa9 \uadf8\ub9ac\uace0 \uc5b4\uae68\ub97c \uac15\ud654\uc2dc\ucf1c\uc8fc\uace0 \ud0c4\ub825\uc788\uac8c \ub9cc\ub4e4\uc5b4\uc90d\ub2c8\ub2e4."}]}