{"name":"\uc2a4\ud2b8\ub808\uc774\ud2b8 \uc554 \ud50c\ub7ad\ud06c","introduce":"\ud478\uc2dc\uc5c5 \uc2dc\uc791 \uc790\uc138\ub85c \ud314\uc744 \ucb49 \ud3b8 \uc0c1\ud0dc\ub85c \ubc84 \ud301\ub2c8\ub2e4. \\n\\n\ucc99\ucd94\ub97c \uace7\uac8c \ud3b4\uc138\uc694. \uc774 \uc790\uc138\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4.\\n\\n\ud638\ud761\uc744 \uba48\ucd94\uc9c0 \ub9c8\uc138\uc694. \ud638\ud761\uc740 \ud3c9\uc0c1\uc2dc\ucc98\ub7fc, \uac00\uc2b4\uc774 \uc544\ub2c8\ub77c \ubc30\ub85c \ud558\uc138\uc694.\\n\\n\uc774 \ub3d9\uc791\uc740 \ubcf5\ubd80\uc640 \ub4f1 \uadfc\uc721\uc744 \uac15\ud654\uc2dc\ucf1c\uc90d\ub2c8\ub2e4.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ubab8\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ub450 \uc190\uc744 \uc5b4\uae68 \ubc14\ub85c \ubc11\uc5d0 \ub193\uc73c\uc138\uc694."},{"type":0,"text":"\uc911\ucd94\uc640 \ub454\uadfc\uc744 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\ud5c8\ub9ac\ub97c \ubc11\uc73c\ub85c \ub0b4\ub9ac\uac70\ub098 \ud799\uc744 \uc704\ub85c \uc62c\ub9ac\uc9c0 \ub9c8\uc138\uc694."},{"type":4,"text":"\uae4a\uac8c \uc2ec\ud638\ud761\ud558\uc138\uc694."},{"type":0,"text":"\ub108\ubb34 \uc26c\uc6b4\uac00\uc694? \ub4f1\uc5d0 \ubb34\uac8c\ub97c \ub354\ud558\uc138\uc694."},{"type":0,"text":"\ubcf5\ubd80\uac00 \ud0c0\ub294 \ub4ef \ub290\uaef4\uc9c0\uac70\ub098, \uc2ec\uc9c0\uc5b4 \ub5a8\ub9b4 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc911\ucd94 \ubc0f \ud5c8\ub9ac\uc5d0 \uc815\ub9d0 \uc88b\uc2b5\ub2c8\ub2e4."}]}