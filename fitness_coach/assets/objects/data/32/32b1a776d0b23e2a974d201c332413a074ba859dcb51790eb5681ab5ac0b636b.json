{"name":"\ube60\ub978 \ubc1c","introduce":"\ubc1c\uc744 \uc5b4\uae68 \ub108\ube44\ub9cc\ud07c \ubc8c\ub9b0 \uc0c1\ud0dc\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4. \ub450 \ub2e4\ub9ac\ub97c \uc57d\uac04 \uad6c\ubd80\ub9ac\uace0 \uc0c1\uccb4\ub97c \uc55e\uc73c\ub85c \uae30\uc6b8\uc785\ub2c8\ub2e4.\\n\\n\ub450 \uc190\uc744 \uc55e\uc5d0 \ub454 \uc0c1\ud0dc\ub85c \uade0\ud615\uc744 \uc720\uc9c0\ud558\uace0 \ube60\ub978 \uc18d\ub3c4\ub85c \uc81c\uc790\ub9ac \ub2ec\ub9ac\uae30\ub97c \ud569\ub2c8\ub2e4.","tips":[{"type":0,"text":"\uc0c1\uccb4\ub97c \uace0\uc815\ud558\uc138\uc694."},{"type":0,"text":"\ucf54\uc5b4\uc5d0 \uae34\uc7a5\uac10\uc744 \uc8fc\uc138\uc694."},{"type":0,"text":"\uc548\uc815\uc801\uc774\uace0 \uae4a\uc740 \uc228\uc744 \uc26c\uc138\uc694."},{"type":0,"text":"\ub354 \uc5b4\ub835\uac8c \ud558\ub824\uba74 \ucd5c\ub300\ud55c \ube60\ub978 \uc2a4\ud15d\uc744 \ud558\uc138\uc694."},{"type":0,"text":"\uc2ec\uc7a5 \ubc15\ub3d9\uc218\uac00 \ube68\ub77c\uc9c0\ub294 \uac78 \ub290\ub084 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc0ac\ub450\uadfc\uacfc \uc885\uc544\ub9ac\uc5d0 \uc88b\uc2b5\ub2c8\ub2e4."},{"type":2,"text":"\uc2a4\ud53c\ub4dc\uc640 \ubbfc\ucca9\uc131\uc744 \ub192\uc774\ub294 \ub370 \uc88b\uc740 \uc6b4\ub3d9\uc785\ub2c8\ub2e4."}]}