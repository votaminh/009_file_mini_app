{"name":"\uc549\uc740 \uc0c1\ud0dc\uc5d0\uc11c \uba38\ub9ac \ub4a4\ub85c \uc0bc\ub450\uadfc \ud3b4\uae30","introduce":"\ub4f1\uc744 \ub611\ubc14\ub85c \ud3b4\uace0 \ubca4\uce58\uc5d0 \uc549\uc73c\uc138\uc694. \uc591\uc190 \ubaa8\ub450 \uac00\ubccd\uac8c \uc8fc\uba39\uc744 \uc954 \ub2e4\uc74c \uc190\uc744 \ubaa8\uc544 \uc8fc\uc138\uc694.\\n\\n\uc591\uc190\uc744 \uba38\ub9ac \uc704\ub85c \uc62c\ub9ac\uace0, \uadf8\ub2e4\uc74c\uc5d4 \uba38\ub9ac \ub4a4\ub85c \ub0b4\ub824 \uc8fc\uc138\uc694. \ub2e4\uc2dc \uba38\ub9ac \uc704\ub85c \uc62c\ub9ac\uace0, \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":12,"text":"\ubca4\uce58\ub97c \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\ub4f1\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ud314 \uc704\ucabd\uc744 \uc81c\uc790\ub9ac\uc5d0 \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\uc55e\uc744 \ubc14\ub77c\ubcf4\uc138\uc694."},{"type":0,"text":"\uc5b4\uae68\ub97c \uc62c\ub9ac\uc9c0 \ub9c8\uc138\uc694."},{"type":4,"text":"\uc190\uc744 \ub0b4\ub9ac\uba70 \uc228\uc744 \ub4e4\uc774 \ub9c8\uc2dc\uace0, \uc190\uc744 \uc62c\ub9ac\uba70 \uc228\uc744 \ub0b4\uc26c\uc138\uc694."},{"type":0,"text":"\uc190\uc744 \uc62c\ub9b4 \ub54c \uc0bc\ub450\uadfc\uc744 \uaf49 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\ucf54\uc5b4\ub97c \uaf49 \uc870\uc774\uace0 \ud5c8\ub9ac\ub97c \uc548\uc815\ub418\uac8c \ub9cc\ub4dc\uc138\uc694."},{"type":0,"text":"\ud314\uafc8\uce58\uac00 \uc55e\uc744 \ud5a5\ud558\ub3c4\ub85d \uc720\uc9c0\ud558\uc138\uc694."},{"type":2,"text":"\uc0bc\ub450\ubc15\uadfc\uc5d0 \uc544\uc8fc \uc88b\uc740 \uc6b4\ub3d9\uc785\ub2c8\ub2e4."}]}