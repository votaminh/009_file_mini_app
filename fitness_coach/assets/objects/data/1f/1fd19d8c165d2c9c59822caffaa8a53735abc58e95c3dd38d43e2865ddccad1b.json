{"name":"\uc624\ub978\ucabd\uc73c\ub85c \ub204\uc6cc \ub2e4\ub9ac \uc55e\uc73c\ub85c \ub4e4\uae30","introduce":"\uc624\ub978\ucabd\uc73c\ub85c \ub204\uc6cc \uba38\ub9ac\ub97c \uc624\ub978\ud314\uc5d0 \uc62c\ub824 \ub193\uc73c\uc138\uc694.\\n\\n\ubb34\ub98e\uc744 \uc55e\uc73c\ub85c 90\ub3c4 \uac01\ub3c4\ub85c \uc811\uc73c\uc138\uc694.\\n\\n\uc67c\ucabd \ub2e4\ub9ac\ub97c \ucb49 \ud3b4 \uc704\uc544\ub798\ub85c \ub4e4\uc5b4 \uc62c\ub9ac\uc138\uc694.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ub2e4\ub9ac\ub97c \uace7\uac8c \ud3b4\uace0 \uacc4\uc18d \ub4e4\uc5b4\uc62c\ub9ac\uc138\uc694."},{"type":0,"text":"\ubab8\uacfc \uc218\uc9c1 \ubc29\ud5a5\uc73c\ub85c \ub2e4\ub9ac\ub97c \ub4e4\uc5b4\uc62c\ub9ac\uc138\uc694."},{"type":0,"text":"\ub2e4\ub9ac\ub97c \uc62c\ub9ac\uba70 \uc228\uc744 \ub0b4\uc26c\uace0, \ub0b4\ub9ac\uba70 \uc228\uc744 \ub4e4\uc774 \ub9c8\uc2dc\uc138\uc694."},{"type":0,"text":"\ub454\uadfc\uc774 \uc0ac\uc6a9\ub418\ub294 \uac83\uc744 \ub290\ub084 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"type":0,"text":"\ub454\uadfc\uc5d0 \ud798\uc774 \ub4e4\uc5b4\uac00\ub294 \ub290\ub08c\uc774 \uc5c6\uc73c\uba74 \ud799\uc744 \uc57d\uac04 \uc55e\uc73c\ub85c \ud68c\uc804\ud558\uc138\uc694."},{"type":0,"text":"\ubc1c\uac00\ub77d\uc744 \uc544\ub798 \ubc29\ud5a5\uc73c\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ub4f1\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub454\uadfc\uc744 \uac15\ud654\uc2dc\ucf1c\uc90d\ub2c8\ub2e4."}]}