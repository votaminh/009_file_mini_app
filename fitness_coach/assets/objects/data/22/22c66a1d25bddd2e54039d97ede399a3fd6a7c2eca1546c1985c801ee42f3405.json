{"name":"\ud544\ub77c\ud14c\uc2a4 \uc870\uac1c \uaecd\ub370\uae30 \uc624\ub978\ucabd","introduce":"\uc67c\ucabd\uc73c\ub85c \ub204\uc6cc \uba38\ub9ac\ub97c \uc67c\ucabd \ud314\uc5d0 \ub0b4\ub824 \ub193\uace0 \ubb34\ub98e\uc744 \uad6c\ubd80\ub9bd\ub2c8\ub2e4.\\n\\n\ubc1c\ub4a4\uafc8\uce58\ub97c \ubd99\uc778\ucc44 \uc624\ub978\ucabd \ubb34\ub98e\uc744 \ub4e4\uc5b4 \uc62c\ub838\ub2e4\uac00 \uc2dc\uc791 \uc704\uce58\ub85c \ub3cc\uc544\uac11\ub2c8\ub2e4. \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c\ud569\ub2c8\ub2e4."},{"type":0,"text":"\uc6b4\ub3d9 \uc911 \uace8\ubc18\uacfc \ubab8\ud1b5\uc744 \uc548\uc815\ub418\uac8c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ucf54\uc5b4\ub97c \uc870\uc774\uace0 \ud5c8\ub9ac \ucc99\ucd94\ub97c \uc911\ub9bd \uc0c1\ud0dc\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\uc704\ucabd \ubb34\ub98e\uc744 \uc62c\ub9ac\uba70 \uc228\uc744 \ub0b4\uc26c\uace0, \ub0b4\ub9ac\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub454\uadfc\uacfc \ud5c8\ubc85\uc9c0\ub97c \uac15\ud654\uc2dc\ucf1c\uc90d\ub2c8\ub2e4."}]}