{"name":"\uc544\ub839 \uc810\ud551 \uc2a4\ucffc\ud2b8","introduce":"\ub450 \ubc1c\uc744 \uc5b4\uae68 \ub108\ube44\ubcf4\ub2e4 \uc870\uae08 \ub354 \ub113\uac8c \ubc8c\ub9ac\uace0 \uc11c\uc11c \uc591 \uc190\uc5d0 \uc544\ub839\uc744 \ud558\ub098\uc529 \ub4ed\ub2c8\ub2e4.\\n\\n\ud5c8\ubc85\uc9c0\uac00 \ubc14\ub2e5\uacfc \ud3c9\ud589\uc774 \ub418\ub3c4\ub85d \uc2a4\ucffc\ud2b8\ub97c \ud588\ub2e4\uac00 \ubc1c \ub4a4\uafc8\uce58\ub97c \ubc00\uc5b4 \uc62c\ub824 \uc810\ud504\ub97c \ud569\ub2c8\ub2e4.\\n\\n\uc2dc\uc791 \uc704\uce58\ub85c \ub3cc\uc544\uac00 \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":17,"text":"2\uac1c\uc758 \uc544\ub839 \ub610\ub294 \uadf8 \ube44\uc2b7\ud55c \uac83\uc744 \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\ubc1c\uc758 \ubcfc\ub85c \ucc29\uc9c0\ub97c \ud574\uc57c \ucda9\uaca9\uc774 \ud761\uc218\ub429\ub2c8\ub2e4."},{"type":0,"text":"\uac15\ud558\uac8c \ubc1c \ub4a4\uafc8\uce58\ub97c \ubc00\uc5b4\ub0b4\uba70 \uc810\ud504\ud558\uc138\uc694."},{"type":0,"text":"\ucd5c\ub300\ud55c \ub192\uc774 \uc810\ud504\ud558\uc138\uc694."},{"type":0,"text":"\ub4f1\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ub0b4\ub824\uac00\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uace0 \uc62c\ub77c\uac00\uba70 \uc228\uc744 \ub0b4\uc26c\uc138\uc694."},{"type":2,"text":"\ub2e4\ub9ac\uc640 \ub454\uadfc\uc744 \uc704\ud574 \uc88b\uc740 \uc6b4\ub3d9\uc785\ub2c8\ub2e4."}]}