{"name":"\uac00\uc2b4 \ud50c\ub77c\uc774","introduce":"\ubc14\ub2e5\uc5d0 \ub611\ubc14\ub85c \ub204\uc6cc \ubb34\ub98e\uc744 \uad7d\ud788\uace0 \ub450 \ubc1c\uc740 \ubc14\ub2e5\uc5d0 \ud3c9\ud3c9\ud558\uac8c \ub450\uc138\uc694.\\n\\n\uc591 \uc190\uc5d0 \uc544\ub839\uc744 \ub4e4\uace0 \ud314\uafc8\uce58\ub97c \uc545\uac04 \uad7d\ud78c\ucc44 \uc190\ubc14\ub2e5\uc774 \uc11c\ub85c\ub97c \ub9c8\uc8fc\ubcf4\uac8c \ub450 \ud314\uc744 \ud558\ub298 \uc704\ub85c \ub4e4\uc5b4 \uc62c\ub9ac\uc138\uc694.\\n\\n\uc717\ud314\uc774 \ubc14\ub2e5\uc5d0 \ub2ff\uc744 \ub54c\uae4c\uc9c0 \uc544\ub839\uc744 \uc591 \uc606\uc73c\ub85c \ub0b4\ub824\ub193\uc73c\uc138\uc694. \uc6d0 \uc704\uce58\ub85c \ub3cc\uc544\uac00 \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":17,"text":"\uc544\ub839\uc744 2\uac1c \uc900\ube44\ud558\uc138\uc694."},{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ub4f1\uc744 \ud56d\uc0c1 \ubc14\ub2e5\uc5d0 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ud314\uc744 \ub4e4\uc5b4 \uc62c\ub9ac\uba70 \uc228\uc744 \ub0b4\uc26c\uace0, \ub0b4\ub9ac\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uc138\uc694."},{"type":0,"text":"\uac00\uc2b4\uc774 \uc6b4\ub3d9\ub418\ub294 \uac83\uc774 \ub290\uaef4\uc838\uc57c\ud569\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uac00\uc2b4 \uadfc\uc721\uc744 \uac15\ud654\uc2dc\ud0b5\ub2c8\ub2e4."}]}