{"name":"\uc67c\ucabd \uc2a4\ud0e0\ub529 \uc624\ube14\ub9ac\ud06c \ud06c\ub7f0\uce58","introduce":"\uc67c\uc190\uc744 \uba38\ub9ac \uc704\ub85c \ub4e4\uace0 \uc624\ub978\uc190\uc740 \ud5c8\ub9ac\uc5d0 \ub300\uace0 \uc11c\uc11c \uc2dc\uc791\ud569\ub2c8\ub2e4. \\n\\n\uc67c\ucabd \ud314\uafc8\uce58\uc640 \uc67c\ucabd \ubb34\ub98e\uc744 \uc11c\ub85c \ubd99\uc785\ub2c8\ub2e4. \ubab8\uc744 \ud3b8 \ub2e4\uc74c \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":0,"text":"\uac00\ub2a5\ud55c \ub4e4\uc5b4\uc62c\ub9b0 \uc591 \ubc1c\uc774 \ubc14\ub2e5\uc5d0 \ub2ff\uc9c0 \uc54a\ub3c4\ub85d \ud558\uc138\uc694."},{"type":0,"text":"\uade0\ud615\uc744 \uc7a1\uae30 \uc704\ud574 \ubcbd\uc774\ub098 \uc758\uc790 \ub4f1\uc744 \uc7a1\uc544\ub3c4 \ub429\ub2c8\ub2e4."},{"type":0,"text":"\uc218\ucd95\ud560 \ub54c \uc228\uc744 \ub0b4\uc26c\uace0, \uc774\uc644\ud560 \ub54c \ub4e4\uc774\uc26c\uc138\uc694."},{"type":0,"text":"\ubcf5\uc0ac\uadfc\uc744 \ucd5c\ub300\ud55c \uc790\uadf9\ud558\uae30 \uc704\ud574 \ucc9c\ucc9c\ud788 \ud558\uc138\uc694."},{"type":0,"text":"\uc5c9\ub369\uc774\ub294 \uc6c0\uc9c1\uc774\uc9c0 \uc54a\ub3c4\ub85d \uc720\uc9c0\ud558\uc138\uc694."}]}