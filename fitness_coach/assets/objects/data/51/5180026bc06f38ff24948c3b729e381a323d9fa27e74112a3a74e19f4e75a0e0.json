{"name":"\uc758\uc790 \uc2a4\ucffc\ud2b8","introduce":"\uc790\uc2e0\uc758 \ubb34\ub98e \uc815\ub3c4 \ub192\uc774\uc5d0 \uc624\ub294 \uc758\uc790\ub97c \uc900\ube44\ud574\uc11c, \ubc14\ub85c \ub4a4\uc5d0 \ub193\uc73c\uc138\uc694. \\n\\n\uc591\ubc1c\uc744 \uc5b4\uae68 \ub108\ube44 \uc815\ub3c4\ub85c \ubc8c\ub9ac\uace0 \uc11c\uc11c, \uc591\ud314\uc744 \uc815\uba74\uc744 \ud5a5\ud574 \uace7\uac8c \ubed7\uc2b5\ub2c8\ub2e4. \uadf8\ub7f0 \ub2e4\uc74c \ubab8\uc744 \ub0b4\ub824, \ucc9c\ucc9c\ud788 \uc758\uc790\uc5d0 \uc549\uc2b5\ub2c8\ub2e4. \\n\\n\ub454\uadfc\uc5d0 \ud798\uc744 \uc9d1\uc911\ud558\uba74\uc11c, \ub2e4\uc2dc \uc120 \uc790\uc138\ub85c \ub3cc\uc544\uac00\uc138\uc694. \uc774 \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":18,"text":"\uc758\uc790\ub97c \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\ubb34\ub98e\uc744 \ubc1c\uac00\ub77d\uacfc \uac19\uc740 \ubc29\ud5a5\uc73c\ub85c \ubed7\uc5b4\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ubb34\ub98e\uc774 \ubc1c\uac00\ub77d\uc744 \ub118\uc5b4\uc11c\uba74 \uc548\ub429\ub2c8\ub2e4.\t"},{"type":4,"text":"\ub0b4\ub824\uac00\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uace0, \uc62c\ub77c\uc624\uba70 \uc228\uc744 \ub0b4\uc26c\uc138\uc694.\t"},{"type":0,"text":"\uc6b4\ub3d9\uc774 \ub108\ubb34 \uc26c\uc6b0\uba74, \uc758\uc790\ub97c \uce58\uc6b0\uace0 \ud558\uc138\uc694."},{"type":0,"text":"\ub454\uadfc\uc774 \ud0c0\ub294 \ub4ef\uc774 \ub290\uaef4\uc838\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\uc774 \uc6b4\ub3d9\uc740 \ud558\uccb4\ub97c \ub2e8\ub828\uc2dc\ucf1c \uc90d\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc5c9\ub369\uc774, \ud5c8\ubc85\uc9c0, \ub454\uadfc\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4."}]}