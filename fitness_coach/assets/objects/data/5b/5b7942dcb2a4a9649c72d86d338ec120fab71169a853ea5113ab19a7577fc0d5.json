{"name":"\uc218\uc815\ub41c \ubc84\ud53c","introduce":"\ub450 \ub2e4\ub9ac\ub97c \uc5b4\uae68 \ub108\ube44\ub9cc\ud07c \ubc8c\ub9ac\uace0 \uc11c\uc138\uc694. \ub450 \uc190\uc744 \ubc14\ub2e5\uc5d0 \uc9da\uace0 \ub450 \ubc1c\uc744 \ub4a4\ub85c \ucc3c\ub2e4\uac00 \ub2e4\uc2dc \uc6d0\uc704\uce58\ub85c \ub3cc\uc544\uac00\uba70 \uc810\ud504\ud569\ub2c8\ub2e4. \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\uc911\ucd94\ub97c \uaf49 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\ub450 \uc190\uc744 \ubb34\ub98e \uc0ac\uc774\uc5d0 \ub450\uc138\uc694."},{"type":0,"text":"\ubab8 \ub300\uc2e0 \ub2e4\ub9ac\ub97c \uad7d\ud600 \ub450 \uc190\uc744 \ubc14\ub2e5\uc5d0 \ub450\uc138\uc694."},{"type":0,"text":"\ub4f1\uacfc \uc5b4\uae68\uc5d0 \ubb34\ub9ac\uac00 \uac00\uba74 \uc548\ub429\ub2c8\ub2e4."},{"type":0,"text":"\uc774 \uc6b4\ub3d9\uc758 \ub2e8\uacc4\ub97c \uac00\ub2a5\ud55c \ube68\ub9ac \uc218\ud589\ud558\uc138\uc694."},{"type":0,"text":"\ub0b4\ub824\uac00\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uace0, \uc62c\ub77c\uc624\uba70 \uc228\uc744 \ub0b4\uc26c\uc138\uc694."},{"type":2,"text":"\uc800\ud76c\uac00 \uad8c\uc7a5\ud574\ub4dc\ub9ac\ub294 \uc544\uc8fc \ud6cc\ub96d\ud55c \uc6b4\ub3d9\uc785\ub2c8\ub2e4."}]}