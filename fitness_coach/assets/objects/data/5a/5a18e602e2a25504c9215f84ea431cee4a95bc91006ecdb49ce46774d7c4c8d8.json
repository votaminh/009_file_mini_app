{"name":"\uc544\ub839 \ub7f0\uc9c0","introduce":"\ub450 \ubc1c\uc744 \uc5b4\uae68 \ub108\ube44\ub9cc\ud07c \ubc8c\ub9ac\uace0 \uc11c\uc11c \uc591 \uc190\uc5d0 \uc544\ub839\uc744 \ub4e4\uace0 \uc591 \ucabd\uc5d0 \ub461\ub2c8\ub2e4.\\n\\n\uc624\ub978 \ub2e4\ub9ac\ub97c \ud06c\uac8c \uc55e\uc73c\ub85c \ub0b4\ubc00\uba74\uc11c \uc624\ub978\ucabd \ud5c8\ubc85\uc9c0\uac00 \ubc14\ub2e5\uacfc \ud3c9\ud589\uc774 \ub420 \ub54c\uae4c\uc9c0 \ubab8\uc744 \ub0b4\ub9bd\ub2c8\ub2e4.\\n\\n\uc2dc\uc791 \uc704\uce58\ub85c \ub3cc\uc544\uac00 \ub2e4\ub978 \ucabd \ub2e4\ub9ac\ub85c \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":17,"text":"2\uac1c\uc758 \uc544\ub839 \ub610\ub294 \uadf8 \ube44\uc2b7\ud55c \uac83\uc744 \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\uc55e \ubb34\ub98e\uc774 \ubc1c\uac00\ub77d\uc744 \ub118\uc5b4\uac00\uba74 \uc548\ub429\ub2c8\ub2e4."},{"type":0,"text":"\uc55e \ubb34\ub98e\uc774 90\ub3c4 \uac01\ub3c4\uac00 \ub420 \ub54c\uae4c\uc9c0 \ubab8\uc744 \ub0b4\ub9ac\uc138\uc694."},{"type":0,"text":"\uc544\ub798\ub85c \ub0b4\ub824\uac00\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uace0 \uc62c\ub77c\uc624\uba70 \ub0b4\uc27d\ub2c8\ub2e4."},{"type":0,"text":"\ubb34\ub98e\uc5d0 \ud070 \ubb34\ub9ac\uac00 \ub290\uaef4\uc9c0\uba74 \uc548\ub429\ub2c8\ub2e4."},{"type":0,"text":"\ub4f1\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ub4b7 \ub2e4\ub9ac\ub97c \ub2e4\uce58\uc9c0 \uc54a\uc73c\ub824\uba74 \ub108\ubb34 \ud06c\uac8c \uc55e\uc73c\ub85c \ub098\uac00\uc9c0 \ub9c8\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc0ac\ub450\uadfc, \ub300\ub454\uadfc \uadf8\ub9ac\uace0 \uc2ac\uac74\uc744 \uac15\ud654\uc2dc\ud0b5\ub2c8\ub2e4."}]}