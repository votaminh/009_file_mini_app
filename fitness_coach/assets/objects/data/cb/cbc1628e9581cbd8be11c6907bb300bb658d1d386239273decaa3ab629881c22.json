{"name":"\uac00\uc704","introduce":"\ub611\ubc14\ub85c \ub204\uc6cc \uc190\ubc14\ub2e5\uc774 \ub545\uc73c\ub85c \ud5a5\ud558\uac8c \ud314\uc744 \ubab8 \uc606\uc5d0 \ub193\uace0 \ub2e4\ub9ac\ub97c \ucb49 \ud3b4\uc138\uc694. \\n\\n\ub450 \ub2e4\ub9ac\ub97c \ub4e4\uc5b4 \uc62c\ub824 \uc624\ub978\ucabd \ud5c8\ubc85\uc9c0\ub97c \uc67c\ucabd \ud5c8\ubc85\uc9c0 \uc704\ub85c \uad50\ucc28 \uc2dc\ud0a4\uc138\uc694. \ubc18\ub300 \ubc29\ud5a5\uc73c\ub85c \ub2e4\uc2dc \ud558\uc138\uc694.\\n\\n\ud301: \ub4f1\uc740 \ud56d\uc0c1 \ud3c9\ud3c9\ud574\uc57c \ud569\ub2c8\ub2e4.\\n\\n\uadfc\uc721: \uc0ac\uadfc, \ubcf5\uc9c1\uadfc","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ub4f1\uc744 \ubc14\ub2e5\uc5d0 \ud3c9\ud3c9\ud558\uac8c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ubb34\ub98e\uc744 \uc0b4\uc9dd \uad6c\ubd80\ub9ac\uc138\uc694."},{"type":4,"text":"\uc815\uc0c1\uc801\uc73c\ub85c \uc2ec\ud638\ud761\ud558\uc138\uc694."},{"type":0,"text":"\ub354 \uc27d\uac8c \ud558\ub824\uba74 \ub450 \uc190\uc744 \ub454\uadfc \uc544\ub798\uc5d0 \ub193\uace0 \uc911\uc2ec\uc744 \uc7a1\uc73c\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc544\ub7ab\ubc30\ub97c \uc9d1\uc911\uacf5\uaca9\ud569\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uade0\ud615\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \ud070 \ub3c4\uc6c0\uc774\ub429\ub2c8\ub2e4."}]}