{"name":"\u8179\u659c\u7b4b\u30af\u30e9\u30f3\u30c1","introduce":"\u5e8a\u306b\u3042\u304a\u5411\u3051\u306b\u306a\u308a\u3001\u819d\u3092\u66f2\u3052\u3066\u4e21\u8db3\u306f\u80a9\u5e45\u3088\u308a\u5c11\u3057\u5e83\u304f\u3057\u307e\u3059\u3002\u4e21\u624b\u306f\u4e21\u8033\u306e\u5f8c\u308d\u306b\u7f6e\u304d\u307e\u3059\u3002\\n\\n\u80a9\u3092\u5e8a\u304b\u3089\u6301\u3061\u4e0a\u3052\u3001\u8179\u7b4b\u306b\u529b\u3092\u5165\u308c\u3066\u53f3\u624b\u3092\u5de6\u819d\u306e\u5916\u5074\u306b\u4f38\u3070\u3057\u307e\u3059\u3002\\n\\n\u3086\u3063\u304f\u308a\u3068\u623b\u308a\u3001\u53cd\u5bfe\u5074\u3082\u884c\u3063\u3066\u7e70\u308a\u8fd4\u3057\u307e\u3059\u3002","tips":[{"type":10,"text":"\u30de\u30c3\u30c8\u3092\u6e96\u5099\u3057\u3066\u304f\u3060\u3055\u3044\u3002"},{"type":0,"text":"\u30d2\u30c3\u30d7\u306f\u5e8a\u306b\u7740\u3051\u305f\u307e\u307e\u884c\u3044\u307e\u3059\u3002"},{"type":0,"text":"\u30b3\u30a2\u30de\u30c3\u30b9\u30eb\u3092\u5f15\u304d\u7de0\u3081\u305f\u307e\u307e\u884c\u3063\u3066\u304f\u3060\u3055\u3044\u3002"},{"type":0,"text":"\u9996\u3084\u80cc\u4e2d\u306e\u4e0a\u90e8\u306b\u529b\u3092\u5165\u308c\u904e\u304e\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"},{"type":0,"text":"\u8eab\u4f53\u3092\u4e0a\u3052\u306a\u304c\u3089\u606f\u3092\u5410\u304d\u3001\u4e0b\u3052\u306a\u304c\u3089\u606f\u3092\u5438\u3044\u307e\u3059\u3002"},{"type":0,"text":"\u8179\u659c\u7b4b\u3068\u8179\u7b4b\u304c\u71b1\u304f\u306a\u308b\u306e\u3092\u611f\u3058\u308b\u306f\u305a\u3067\u3059\u3002"},{"type":2,"text":"\u8179\u76f4\u7b4b\u3068\u8179\u659c\u7b4b\u306b\u52b9\u679c\u306e\u3042\u308b\u30a8\u30af\u30b5\u30b5\u30a4\u30ba\u3067\u3059\u3002"}]}