{"name":"\ub9ac\ubc84\uc2a4 \ud06c\ub7f0\uce58","introduce":"\ubc14\ub2e5\uc5d0 \ub204\uc6cc \ubb34\ub98e\uc744 \uad7d\ud788\uace0 \ub450 \ub2e4\ub9ac\ub97c 90\ub3c4 \uac01\ub3c4\ub85c \uc62c\ub9bd\ub2c8\ub2e4. \\n\\n\ubc30\uc5d0 \ud798\uc744 \uc8fc\uc5b4 \uc228\uc744 \ub0b4\uc26c\uace0, \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uba74\uc11c \ucc9c\ucc9c\ud788 \ub2e4\ub9ac\ub97c \ub0b4\ub9bd\ub2c8\ub2e4. \uc774 \ub3d9\uc791\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ubcf5\uadfc\uc758 \ud798\uc744 \uc0ac\uc6a9\ud558\uc138\uc694."},{"type":0,"text":"\ubb34\ub98e\uc774 \ucf54\uc5d0 \ub2ff\uac8c \ud558\uc138\uc694."},{"type":0,"text":"\ud314\uafc8\uce58\uac00 \ubb34\ub98e\ucabd\uc73c\ub85c \uc624\uc9c0 \uc54a\uac8c \ud558\uc138\uc694."},{"type":0,"text":"\ub4f1 \uc544\ub7ab\ubd80\ubd84\uc744 \ub545\uc5d0\uc11c \ub5bc\uc9c0 \ub9c8\uc138\uc694."},{"type":0,"text":"\ub450 \uc190\uc740 \uadc0 \ub4a4\uc5d0 \ub450\uace0 \uae4d\uc9c0\ub294 \ub07c\uc9c0 \ub9c8\uc138\uc694."},{"type":0,"text":"\uc228\uc744 \ub0b4\uc26c\uba70 \uc5b4\uae68\ub97c \uc62c\ub9ac\uace0 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uba70 \ub0b4\ub9ac\uc138\uc694."},{"type":0,"text":"\ubaa9\uc5d0 \ub108\ubb34 \ub9ce\uc740 \ud798\uc744 \uc8fc\uba74 \uc548\ub429\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ud558\ubcf5\ubd80\ub97c \uc9d1\uc911 \uacf5\uaca9\ud569\ub2c8\ub2e4."}]}