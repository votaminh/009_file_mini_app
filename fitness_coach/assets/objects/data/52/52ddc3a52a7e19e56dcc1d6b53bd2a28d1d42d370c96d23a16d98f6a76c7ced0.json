{"name":"\ubc15\uc218\uce58\uba70 \uc717\ubab8 \uc77c\uc73c\ud0a4\uae30","introduce":"\ubc14\ub2e5\uc5d0 \uc549\uc544 \ubb34\ub98e\uc744 \uad7d\ud788\uace0 \ubc1c\uc740 \uc870\uae08 \ub4e0 \ud6c4 \ub4f1\uc744 \ub4a4\ucabd\uc73c\ub85c \uae30\uc6b8\uc774\uc138\uc694. \\n\\n\uad50\ub300\ub85c \ub2e4\ub9ac\ub97c \ub4e4\uc5b4\uc62c\ub824 \ubb34\ub98e \uc544\ub798\uc5d0\uc11c \ubc15\uc218 \uce58\uc138\uc694.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud558\ub294 \uac83\uc744 \ucd94\ucc9c\ud569\ub2c8\ub2e4."},{"type":0,"text":"\uc55e\uc744 \ub611\ubc14\ub85c \ubcf4\uc138\uc694."},{"type":0,"text":"\ubaa9\uc744 \ud3b8\uc548\ud558\uac8c \ub450\uc138\uc694."},{"type":0,"text":"\uc0c1\uccb4\ub97c \uc6c0\uc9c1\uc774\uc9c0 \ub9c8\uc138\uc694."},{"type":4,"text":"\ubb34\ub98e\uc744 \uc62c\ub9b4 \ub54c \uc228\uc744 \ub0b4\uc26c\uace0 \ub0b4\ub9b4\ub54c \uc228\uc744 \ub4e4\uc774 \ub9c8\uc2dc\uc138\uc694."},{"type":0,"text":"\uc6b4\ub3d9\uc744 \ub354 \uc5b4\ub835\uac8c \ub9cc\ub4e4\uace0 \uc2f6\ub2e4\uba74 \ub2e4\ub9ac\ub97c \uc77c\uc790\ub85c \ud3b4\uc138\uc694."},{"type":0,"text":"\ub108\ubb34 \uc5b4\ub835\ub2e4\uba74 \ubc1c\uc744 \ub545 \uc704\uc5d0 \uc62c\ub824 \ub193\uc73c\uc138\uc694."},{"type":0,"text":"\ubcf5\ubd80\uac00 \ud0c0\ub294 \ub4ef\ud55c \ub290\ub08c, \ub610\ub294 \uc2ec\uc9c0\uc5b4 \ub5a8\ub9ac\ub294 \ub290\ub08c\uc774 \ub4e4\uc5b4\uc57c\ud569\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc8fc\ub85c \ubcf5\ubd80 \uadfc\uc721\uc744 \uacf5\ub7b5\ud569\ub2c8\ub2e4."}]}