{"name":"\uc606\uc73c\ub85c \ub2e4\ub9ac \ub4e4\uc5b4 \uc62c\ub9ac\uae30 \uc67c\ucabd","introduce":"\uc624\ub978\ucabd\uc73c\ub85c \ub204\uc6cc \ud314\ub69d\uc73c\ub85c \uc0c1\uccb4\ub97c \uc9c0\ud0f1\ud558\uace0 \uc67c\uc190\uc744 \ubab8 \uc55e \ubc14\ub2e5\uc5d0 \uc62c\ub824 \ub193\uc73c\uc138\uc694.\\n\\n\ub450 \ub2e4\ub9ac\ub97c \ubd99\uc774\uc138\uc694. \ub450 \ub2e4\ub9ac\ub97c \uc0b4\uc9dd \ub4e4\uc5b4\uc62c\ub824 1\ucd08 \ub3d9\uc548 \uadf8 \uc790\uc138\ub97c \uc720\uc9c0\ud588\ub2e4\uac00 \ub2e4\uc2dc \uc2dc\uc791 \uc704\uce58\ub85c \ub3cc\uc544\uc624\uc138\uc694. \ub2e4\ub978 \ucabd\uc73c\ub85c \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c\ud569\ub2c8\ub2e4."},{"type":0,"text":"\ub450 \ub2e4\ub9ac\ub97c \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ud799\uc744 \ub2e4\uce58\uc9c0 \uc54a\uac8c \ucc9c\ucc9c\ud788 \uc6b4\ub3d9\ud558\uc138\uc694."},{"type":0,"text":"\ud314\ub69d\uc744 90\ub3c4 \uac01\ub3c4\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ub450 \ubc1c\uc744 \ubd99\uc774\uc138\uc694."},{"type":0,"text":"\ub450 \ub2e4\ub9ac\ub97c \ub4e4\uc5b4 \uc62c\ub9b4 \ub54c 1\ucd08 \ub3d9\uc548 \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ub450 \ub2e4\ub9ac\ub97c \ub4e4\uc5b4 \uc62c\ub9b4 \ub54c \ud799\uc744 \ub3cc\ub9ac\uc9c0 \ub9c8\uc138\uc694."},{"type":0,"text":"\ub2e4\ub9ac\ub97c \ub4e4\uc5b4 \uc62c\ub9ac\uba70 \uc228\uc744 \ub0b4\uc26c\uace0 \ub0b4\ub9ac\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uc138\uc694."},{"type":0,"text":"\uc0ac\uadfc\uc774 \ud0c0\ub294 \ub4ef\uc774 \ub290\uaef4\uc838\uc57c \ud569\ub2c8\ub2e4. \uc2ec\uc9c0\uc5b4 \ub5a8\ub9b4 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"type":2,"text":"\uc0ac\uadfc\uc744 \uc704\ud55c \uc544\uc8fc \uc88b\uc740 \uc6b4\ub3d9\uc785\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ud5c8\ub9bf\uc0b4\uc744 \ud0dc\uc6b0\ub294\ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}]}