{"name":"\uc2a4\ucffc\ud2b8 \uc7ad\uc2a4","introduce":"\ub450 \ubc1c\uc744 \ubd99\uc774\uace0 \uc190\uc740 \uba38\ub9ac \uc704\ub85c \ub4e4\uc5b4 \uc62c\ub9b0 \uc790\uc138\ub85c \uc2dc\uc791\ud558\uc138\uc694.\\n\\n\uc810\ud504\ud55c \ud6c4 \ub2e4\ub9ac\ub97c \ubc8c\ub9ac\uace0 \uc190\uc740 \ub0b4\ub824 \uc2a4\ucffc\ud2b8 \uc790\uc138\ub97c \ucde8\ud558\uc138\uc694.\\n\\n\ub2e4\uc2dc \uc2dc\uc791 \uc704\uce58\ub85c \uc810\ud504\ud588\ub2e4\uac00 \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":0,"text":"\uc2a4\ucffc\ud2b8\ub97c \ud558\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uace0, \uc62c\ub77c\uc624\uba70 \uc228\uc744 \ub0b4\uc26c\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ubaa8\ub4e0 \ud070 \uadfc\uc721 \uadf8\ub8f9, \ud2b9\ud788 \ub454\uadfc\uc744 \uc6b4\ub3d9\uc2dc\ud0b5\ub2c8\ub2e4."}]}