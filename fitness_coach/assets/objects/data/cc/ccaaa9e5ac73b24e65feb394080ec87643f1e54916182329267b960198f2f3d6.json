{"name":"\uc758\uc790\ub97c \uc0ac\uc6a9\ud55c \uc5b4\uae68 \uc2a4\ud2b8\ub808\uce6d","introduce":"\ub4f1\uc744 \uace7\uac8c \ud3b4\uace0 \ub450 \ubc1c\uc740 \ubc14\ub2e5\uc5d0 \uc644\uc804\ud788 \ubd99\uc778 \uc790\uc138\ub85c \uc758\uc790\uc5d0 \uc549\uc2b5\ub2c8\ub2e4. \\n\\n\uc758\uc790\uc758 \ub4b7\ubd80\ubd84\uc744 \uc7a1\uace0, \uc228\uc744 \ud06c\uac8c \ub4e4\uc774\ub9c8\uc2dc\uba74\uc11c \uac00\uc2b4\uacfc \uc5b4\uae68\ub97c \ud3b4\uc138\uc694. \uba87 \ucd08 \ub3d9\uc548 \uc790\uc138\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4.","tips":[{"type":18,"text":"\uc758\uc790\ub97c \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\ub4f1\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\uc5b4\uae68\ub97c \uc73c\uc4f1\uac70\ub9ac\uc9c0 \ub9c8\uc138\uc694."},{"type":4,"text":"\uaddc\uce59\uc801\uc73c\ub85c \ud638\ud761\ud558\uc138\uc694."}]}