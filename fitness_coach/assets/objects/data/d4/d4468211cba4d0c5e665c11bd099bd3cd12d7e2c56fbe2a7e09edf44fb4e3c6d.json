{"name":"\ub364\ubca8 \ub2e4\ub9ac \uad7d\ud788\uace0 \ud2b8\uc704\uc2a4\ud2b8","introduce":"\ubb34\ub98e\uc744 90\ub3c4\ub85c \uad7d\ud788\uace0 \ubc14\ub2e5\uc5d0 \ub611\ubc14\ub85c \ub215\uc2b5\ub2c8\ub2e4. \uc885\uc544\ub9ac\ub97c \uc11c\ub85c \uad50\ucc28\uc2dc\ud0a4\uace0 \uadf8 \uc0ac\uc774\uc5d0 \ub364\ubca8\uc744 \ub07c\uc6c1\ub2c8\ub2e4.\\n\\n\uc190\ubc14\ub2e5\uc740 \uc544\ub798\ub97c \ud5a5\ud558\uac8c \ud574\uc11c \uc591\ud314\uc744 \uc591 \uc606\uc73c\ub85c \ud3c5\ub2c8\ub2e4. \uc0c1\uccb4\ub294 \uadf8\ub300\ub85c \uc720\uc9c0\ud558\uba74\uc11c \ub2e4\ub9ac\ub97c \uc67c\ucabd\uc73c\ub85c \ube44\ud2c9\ub2c8\ub2e4.\\n\\n\ucc9c\ucc9c\ud788 \ub3cc\uc544\uc628 \ud6c4 \ubc18\ub300\ucabd\uc73c\ub85c \ube44\ud2c9\ub2c8\ub2e4. \uc774 \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":13,"text":"\uc544\ub839\uc744 \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\uc6b4\ub3d9\uc744 \ud558\ub294 \ub3d9\uc548 \uacc4\uc18d\ud574\uc11c \ubcf5\uadfc\uc744 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\ubb34\ub98e\uc744 90\ub3c4 \uac01\ub3c4\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\uc18d\ub3c4\ub97c \uc870\uc808\ud558\uba74\uc11c, \ubc18\ub3d9\uc73c\ub85c \uc6c0\uc9c1\uc774\uc9c0 \ub9c8\uc138\uc694."},{"type":0,"text":"\ub2e4\ub9ac\ub97c \ube44\ud2c0 \ub54c, \uc0c1\uccb4\ub294 \uc790\uc138\ub97c \uc720\uc9c0\ud558\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc0ac\uadfc\uc744 \uc6b4\ub3d9\uc2dc\ucf1c \uc90d\ub2c8\ub2e4."}]}