{"name":"\uc544\ub839 \ub7ec\uc2dc\uc548 \ud2b8\uc704\uc2a4\ud2b8","introduce":"\ubc14\ub2e5\uc5d0 \uc549\uc544 \ubb34\ub98e\uc744 \uad7d\ud788\uace0 \ubc1c\uc744 \uc0b4\uc9dd \ub4e4\uc5b4 \uc62c\ub9b0 \ud6c4 \ub4f1\uc744 \ub4a4\ub85c \uad7d\ud799\ub2c8\ub2e4.\\n\\n\uc190\uc5d0 \uc544\ub839\uc744 \ub4e4\uace0 \uc88c\uc6b0\ub85c \ud2b8\uc704\uc2a4\ud2b8\ud569\ub2c8\ub2e4.","tips":[{"type":13,"text":"\uc544\ub839\uc744 \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\uc55e\uc744 \uace7\uc7a5 \uc751\uc2dc\ud558\uc138\uc694."},{"type":0,"text":"\ubcf5\uadfc\uc744 \uaf49 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\ubab8\uc744 \ud2c0 \ub54c\ub9c8\ub2e4 \uc228\uc744 \ub0b4\uc26c\uc138\uc694."},{"type":0,"text":"\ubcf5\uadfc\uc774 \ud0c0\ub294 \ub4ef\uc774 \ub290\uaef4\uc838\uc57c\ud569\ub2c8\ub2e4. \uc2ec\uc9c0\uc5b4 \ub5a8\ub9b4 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."},{"type":0,"text":"\ubaa9\uc5d0 \ud1b5\uc99d\uc744 \ub290\ub07c\uba74 \uc548 \ub429\ub2c8\ub2e4."}]}