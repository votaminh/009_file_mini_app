{"name":"\uc810\ud504 \uc2a4\ucffc\ud2b8","introduce":"\uc2a4\ucffc\ud2b8 \uc2dc\uc791 \uc790\uc138\ub85c, \ubcf5\ubd80\uc758 \ud798\uc73c\ub85c \uc810\ud504\ud569\ub2c8\ub2e4. \uc810\ud504\ud6c4, \ub2e4\uc2dc \ucc29\uc9c0\ud560 \ub54c\ub294 \ucabc\uadf8\ub9ac\ub294 \uc790\uc138\ub85c \ubab8\uc744 \ub0ae\ucd94\uc138\uc694. \\n\\n\uc774 \ub3d9\uc791\uc740 \ubab8 \uc804\uccb4\ub97c \ub530\ub73b\ud558\uac8c\ud558\uc5ec \ubcf5\uadfc\uc6b4\ub3d9\uc744 \uc2dc\uc791\ud558\uae30 \uc88b\uac8c\ud558\ub294 \uc6b4\ub3d9\uc785\ub2c8\ub2e4.","tips":[{"type":0,"text":"\ubcf5\uadfc\uc758 \ud798\uc744 \uc0ac\uc6a9\ud558\ub294 \uac83\uc744 \uae30\uc5b5\ud558\uc138\uc694."},{"type":0,"text":"\ubb34\ub98e\uc744 \ubc1c\uac00\ub77d\uacfc \uac19\uc740 \ubc29\ud5a5\uc73c\ub85c \ub0b4\ubbf8\uc138\uc694."},{"type":0,"text":"\uc2a4\ucffc\ud2b8\ub97c \ud558\uba70 \ub0b4\ub824\uac08 \ub54c \uac00\uc2b4\uc774 \ud799\ubcf4\ub2e4 \ub192\uc740 \uc704\uce58\uc5d0 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ub545\uc5d0 \ucc29\uc9c0\ud560 \ub54c \uadfc\uc721\uc744 \uc0ac\uc6a9\ud574 \ucda9\uaca9\uc744 \ud761\uc218\uc2dc\ud0a4\uc138\uc694."},{"type":0,"text":"\uc2a4\ucffc\ud2b8\ub97c \ud558\uba70 \ub0b4\ub824\uac08 \ub54c \ubb34\ub98e\uc774 \ubc1c\uac00\ub77d\ubcf4\ub2e4 \uc55e\uc73c\ub85c \ub098\uac00\uba74 \uc548\ub429\ub2c8\ub2e4."},{"type":0,"text":"\ub0b4\ub824\uac00\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uace0, \uc62c\ub77c\uc624\uba70 \uc228\uc744 \ub0b4\uc26c\uc138\uc694."},{"type":0,"text":"\ub108\ubb34 \uc27d\ub2e4\uace0 \ub290\uaef4\uc9c0\uba74 \ub450 \uc190\uc744 \uba38\ub9ac \ub4a4\ub85c \uac00\uc838\uac00\uc138\uc694."},{"type":0,"text":"\ub354 \uc5b4\ub835\uac8c \ud558\ub824\uba74 \uc704\ub85c \uc810\ud504\ud560 \ub54c \ub450 \ubc1c\uc744 \ubd99\uc5ec\ubcf4\uc138\uc694."},{"type":0,"text":"\ub108\ubb34 \uc26c\uc6b4\uac00\uc694? \uc704\ub85c \uc810\ud504\ud560 \ub54c \ubb34\ub98e\uc744 \ucd5c\ub300\ud55c \ub192\uc774 \uc62c\ub824\ubcf4\uc138\uc694."},{"type":0,"text":"\ub108\ubb34 \uc5b4\ub835\ub2e4\uace0 \ub290\uaef4\uc9c0\uba74 \ud314\uc758 \ubc18\ub3d9\uc744 \uc0ac\uc6a9\ud574 \ubab8\uc744 \uc704\ub85c \uc62c\ub9ac\uc138\uc694."},{"type":2,"text":"\ub2e4\ub9ac\uc640 \ub454\uadfc\uc744 \uc704\ud55c \uc88b\uc740 \uc6b4\ub3d9\uc785\ub2c8\ub2e4."}]}