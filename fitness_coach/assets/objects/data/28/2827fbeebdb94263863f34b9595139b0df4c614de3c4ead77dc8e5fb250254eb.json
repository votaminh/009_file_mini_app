{"name":"\ub364\ubca8 \ub9ac\ubc84\uc2a4 \uceec","introduce":"\ub450 \ubc1c\uc744 \uc5b4\uae68 \ub108\ube44\ub9cc\ud07c \ubc8c\ub9ac\uace0 \ub611\ubc14\ub85c \uc12d\ub2c8\ub2e4. \uc190\ubc14\ub2e5\uc774 \uc815\uba74\uc744 \ud5a5\ud558\uac8c \ud574\uc11c \uc591\uc190\uc5d0 \ub364\ubca8\uc744 \ud558\ub098\uc529  \uc7a1\uc2b5\ub2c8\ub2e4.\\n\\n\ud314\uafc8\uce58\ub97c \uad7d\ud788\uba70 \ub364\ubca8\uc744 \uc5b4\uae68 \ucabd\uc73c\ub85c \ub4e4\uc5b4 \uc62c\ub9bd\ub2c8\ub2e4. \ucc9c\ucc9c\ud788 \ub3cc\uc544\uac04 \ub2e4\uc74c \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":17,"text":"\uc544\ub839\uc744 2\uac1c \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\uc5b4\uae68\ub97c \ub4a4\ub85c \uc816\ud788\uc138\uc694."},{"type":0,"text":"\uc591\ud314\uc744 \ubab8\uc5d0 \uac00\uae5d\uac8c \ubd99\uc774\uc138\uc694."},{"type":0,"text":"\ub4f1\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ub364\ubca8\uc744 \ub4e4\uc5b4 \uc62c\ub9ac\uba70 \uc228\uc744 \ub0b4\uc26c\uace0, \ub0b4\ub9ac\uba70 \uc228\uc744 \ub4e4\uc774 \ub9c8\uc2dc\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc774\ub450\ubc15\uadfc\uacfc \ud314\ub69d\uc744 \ub2e8\ub828\uc2dc\ud0b5\ub2c8\ub2e4."}]}