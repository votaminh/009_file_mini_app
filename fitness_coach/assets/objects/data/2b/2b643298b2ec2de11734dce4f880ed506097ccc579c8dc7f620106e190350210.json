{"name":"\ubc38\ub9ac \ud504\ub808\uc2a4","introduce":"\uc717\ubc30 \uc55e\uc73c\ub85c \uc591\ud314\uc744 \ubed7\uc2b5\ub2c8\ub2e4. \uc190\ubc14\ub2e5\uc744 \uc704\ub85c \ud5a5\ud574\uc11c \uc591\uc190\uc5d0 \ub364\ubca8\uc744 \ud558\ub098\uc529 \ub4ed\ub2c8\ub2e4. \\n\\n\ud314\uafc8\uce58\ub97c \uad7d\ud600\uc11c \ub364\ubca8\uc744 \uc717\ubc30 \uc55e\uc73c\ub85c \uac00\uc838\uc624\uace0, \ub2e4\uc2dc \ubed7\uc2b5\ub2c8\ub2e4. \uc774 \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":17,"text":"\ubcf8\uc778\uc774 \uc4f0\uae30 \ud3b8\ud55c \ub364\ubca8 \ub450 \uac1c\ub97c \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\uac00\uc2b4\uc5d0 \uc5f4\uc774 \uc624\ub974\ub294 \ub290\ub08c\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},{"type":0,"text":"\ud314\uc744 \ubed7\uc744 \ub54c \uc228\uc744 \ub0b4\uc26c\uace0, \uad7d\ud790 \ub54c \ub4e4\uc774\uc26c\uc138\uc694."},{"type":0,"text":"\ud314\uc744 \ubed7\uc744 \ub54c\ub294 \uac00\uc2b4\uc5d0 \ud798\uc744 \uc8fc\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uac00\uc2b4\uc744 \ub2e8\ub828\uc2dc\ud0b5\ub2c8\ub2e4."}]}