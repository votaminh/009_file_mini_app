{"name":"\ub364\ubca8 \uc810\ud551 \ub7f0\uc9c0","introduce":"\uc591\ud314\uc744 \uc790\uc5f0\uc2a4\ub7fd\uac8c \ub0b4\ub9b0 \uc790\uc138\ub85c \uc591\uc190\uc5d0 \ub364\ubca8\uc744 \ud558\ub098\uc529 \ub4e4\uace0, \ub7f0\uc9c0 \uc790\uc138\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4. \\n\\n\uc704\ub85c \uc810\ud504\ud558\uba74\uc11c \ube60\ub974\uac8c \ub2e4\ub9ac\ub97c \ubc14\uafc9\ub2c8\ub2e4. \uc774 \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":17,"text":"\uc544\ub839\uc744 2\uac1c \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\uc591\ubc1c\ub85c \ubd80\ub4dc\ub7fd\uac8c \ucc29\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\uc0c1\uccb4\ub97c \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\uc55e \ubb34\ub98e\uc774 \ubc1c\uac00\ub77d\uc744 \ub118\uc5b4\uac00\uc9c0 \uc54a\ub3c4\ub85d \uc8fc\uc758\ud558\uc138\uc694."},{"type":0,"text":"\uc810\ud504\ub97c \ud558\uba74\uc11c \uc228\uc744 \ub0b4\uc26c\uace0, \ucc29\uc9c0\ud558\uba74\uc11c \ub4e4\uc774\uc27d\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub300\ud1f4 \uc0ac\ub450\uadfc, \ub454\uadfc, \ud584\uc2a4\ud2b8\ub9c1\uc744 \ub2e8\ub828\uc2dc\ud0b5\ub2c8\ub2e4."}]}