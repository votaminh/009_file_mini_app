{"name":"T \ud50c\ub7ad\ud06c \uc624\ub978\ucabd","introduce":"\uc190\uc774 \ubc14\ub85c \uc5b4\uae68 \ubc11\uc5d0 \uc704\uce58\ud558\ub294 \ud314\uc744 \ucb49 \ubed7\uc740 \ud50c\ub7ad\ud06c \uc790\uc138\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4.\\n\\n\uc0c1\uccb4\ub97c \ud68c\uc804 \ub2f9\uc2e0\uc774, \uc624\ub978\ud314\uc744 \ud558\ub298\ub85c \ucb49 \ubed7\uc5b4 \ubab8\uc774 \u201cT\u201d\uc790 \ubaa8\uc591\uc774 \ub418\ub3c4\ub85d \ub9cc\ub4dc\uc138\uc694.\\n\\n\ucc98\uc74c \uc790\uc138\ub85c \ub3cc\uc544\uc640 \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ubab8\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\uc911\ucd94\uc640 \ub454\uadfc\uc744 \uaf49 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\uc790\uc5f0\uc2a4\ub7fd\uac8c \uc228\uc744 \uc26c\uc138\uc694."},{"type":0,"text":"\ubab8\uc744 \ud68c\uc804\uc2dc\ud0a4\uba70 \ubcf5\uadfc\uc744 \uc218\ucd95\uc2dc\ud0a4\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uade0\ud615\uacfc \uc548\uc815\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294\ub370 \ub3c4\uc6c0\uc774\ub429\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ucf54\uc5b4 \uadfc\uc721\uc5d0 \uc88b\uc2b5\ub2c8\ub2e4."},{"type":2,"text":" \uc0bc\uac01\uadfc\uc5d0 \uc88b\uc740 \uc6b4\ub3d9\uc785\ub2c8\ub2e4."}]}