{"name":"\ubc84\ub4dc \ub3c5","introduce":"\ubb34\ub98e\uc740 \uc5c9\ub369\uc774 \uc544\ub798, \uc190\uc740 \uc5b4\uae68 \uc544\ub798\uc5d0 \ub450\uace0 \uc2dc\uc791\ud569\ub2c8\ub2e4.\\n\\n\ub4e4\uc774\ub9c8\uc2dc\uba70 \ubc30\ub97c \uc774\uc644\ud558\uc138\uc694. \ub0b4\uc26c\uba74\uc11c \ucf54\uc5b4\ub97c \uc870\uc774\uace0 \ud55c\ucabd \ud314\uacfc \ubc18\ub300\ucabd \ub2e4\ub9ac\ub97c \ubed7\uc2b5\ub2c8\ub2e4.\\n\\n5\ucd08\uac04 \uc720\uc9c0\ud55c \ub4a4 \ub3cc\uc544\uc624\uace0, \ubc18\ub300\ucabd\ub3c4 \ud638\ud761\uc5d0 \ub9de\ucdb0 \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ucb49 \ubed7\uc740 \ud314\uacfc \ub2e4\ub9ac\ub97c \ubc14\ub2e5\uacfc \ud3c9\ud589\ud558\uac8c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ubc1c\uac00\ub77d\uc774 \ubc14\ub2e5\uc744 \ud5a5\ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ubcf5\ubd80\ub97c \uaf49 \uc870\uc774\uc138\uc694."},{"type":0,"text":"\ud314\uc774\ub098 \ub2e4\ub9ac\ub97c \ub108\ubb34 \ub192\uc774 \uc62c\ub9ac\uc9c0 \ub9c8\uc138\uc694."},{"type":2,"text":"\uc774 \ub3d9\uc791\uc740 \uc911\ucd94\uc5d0 \uc88b\uc740 \uc6b4\ub3d9\uc785\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ubcf5\ubd80\uc640 \ud5c8\ub9ac\ub97c \uc9d1\uc911 \uacf5\uaca9 \ud569\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc9c0\uad6c\ub825\uc744 \ud0a4\uc6cc\uc8fc\uace0 \uade0\ud615\uc744 \uc798 \uc7a1\uc744 \uc218 \uc788\uac8c \ud574\uc90d\ub2c8\ub2e4."},{"type":4,"text":"\ud314\uacfc \ubc18\ub300\ucabd \ub2e4\ub9ac\ub97c \uc62c\ub9b4 \ub54c \ub0b4\uc26c\uace0, \ub0b4\ub9b4 \ub54c \ub4e4\uc774\ub9c8\uc2ed\ub2c8\ub2e4."}]}