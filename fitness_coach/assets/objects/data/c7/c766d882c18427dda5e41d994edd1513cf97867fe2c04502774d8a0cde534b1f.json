{"name":"\u0627\u0633\u06a9\u0648\u0627\u062a \u0635\u0646\u062f\u0644\u06cc","introduce":"\u06cc\u06a9 \u0635\u0646\u062f\u0644\u06cc \u0631\u0627 \u06a9\u0647 \u0627\u0631\u062a\u0641\u0627\u0639 \u0622\u0646 \u062a\u0642\u0631\u06cc\u0628\u0627\u064b \u0628\u0627 \u0632\u0627\u0646\u0648\u06cc \u0634\u0645\u0627 \u0628\u0631\u0627\u0628\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0622\u0645\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f \u0648 \u0622\u0646 \u0631\u0627 \u062f\u0631\u0633\u062a \u067e\u0634\u062a \u0633\u0631 \u062e\u0648\u062f \u0642\u0631\u0627\u0631 \u062f\u0647\u06cc\u062f.\\n\\n\u067e\u0627\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u0647 \u0639\u0631\u0636 \u0634\u0627\u0646\u0647 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f \u0648 \u062f\u0633\u062a\u0627\u0646 \u062e\u0648\u062f \u0631\u0627 \u0628\u0647 \u0633\u0645\u062a \u062c\u0644\u0648 \u0628\u06a9\u0634\u06cc\u062f. \u0633\u067e\u0633 \u0628\u062f\u0646 \u062e\u0648\u062f \u0631\u0627 \u067e\u0627\u06cc\u06cc\u0646 \u0628\u06cc\u0627\u0648\u0631\u06cc\u062f \u0648 \u0628\u0647 \u0622\u0631\u0627\u0645\u06cc \u0631\u0648\u06cc \u0635\u0646\u062f\u0644\u06cc \u0628\u0646\u0634\u06cc\u0646\u06cc\u062f.\\n\\n\u0645\u0627\u0647\u06cc\u0686\u0647\u200c\u0647\u0627\u06cc \u0633\u0631\u06cc\u0646\u06cc \u062e\u0648\u062f \u0631\u0627 \u0633\u0641\u062a \u06a9\u0646\u06cc\u062f \u0648 \u0628\u0647 \u062d\u0627\u0644\u062a \u0627\u06cc\u0633\u062a\u0627\u062f\u0647 \u0628\u0627\u0632\u06af\u0631\u062f\u06cc\u062f. \u062a\u0645\u0631\u06cc\u0646 \u0631\u0627 \u062a\u06a9\u0631\u0627\u0631 \u06a9\u0646\u06cc\u062f.","tips":[]}