{"name":"\ubc15\uc2a4 \ud478\uc2dc\uc5c5","introduce":"\ubb34\ub98e\uc744 \uc138\uc6b0\uace0 \uc5ce\ub4dc\ub824\uc11c \uc591 \uc190\uc740 \uc5b4\uae68 \uc704\uce58\uc5d0 \ub193\uc2b5\ub2c8\ub2e4. \ud314\uafc8\uce58\ub97c \uad6c\ubd80\ub824\uc11c \ud478\uc2dc\uc5c5\uc744 \ud569\ub2c8\ub2e4. \\n\\n\uc2dc\uc791 \uc704\uce58\ub85c \ub3cc\uc544\uc640\uc11c \ubc18\ubcf5\ud569\ub2c8\ub2e4.","tips":[{"type":10,"text":"\uc774 \uc6b4\ub3d9\uc740 \ub9e4\ud2b8 \uc704\uc5d0\uc11c \ud574\uc57c \ud569\ub2c8\ub2e4."},{"type":0,"text":"\ub4f1\uc744 \uc77c\uc790\ub85c \uc720\uc9c0\ud558\uc138\uc694."},{"type":4,"text":"\ub0b4\ub824\uac00\uba70 \uc228\uc744 \ub4e4\uc774\ub9c8\uc2dc\uace0, \uc62c\ub77c\uc624\uba70 \uc228\uc744 \ub0b4\uc26c\uc138\uc694."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \uc0c1\uccb4\uc5d0 \uc88b\uc2b5\ub2c8\ub2e4."}]}