{"name":"\ubd88\uac00\uc0ac\ub9ac \ud06c\ub7f0\uce58","introduce":"\ub611\ubc14\ub85c \ub204\uc6cc \ub450 \uc190\uc744 \uc591\ucabd\uc5d0 \ucb49 \ubed7\uc73c\uc138\uc694. \ub2e4\ub9ac\ub97c \ubc8c\ub9ac\uace0 \ub450 \ubc1c\uc744 \uc5b4\uae68 \ub108\ube44\ubcf4\ub2e4 \ub113\uac8c \uc720\uc9c0\ud558\uc138\uc694.\\n\\n\uc67c\ucabd \ub2e4\ub9ac\ub97c \ub4e4\uc5b4\uc62c\ub9ac\uace0 \uc5b4\uae68\ub97c \ubc14\ub2e5\uc5d0\uc11c \uc0b4\uc9dd \ub4e4\uc5b4 \uc62c\ub9b0 \ud6c4, \uc624\ub978\uc190\uc73c\ub85c \uc67c\ubc1c\uc744 \ud130\uce58\ud558\uc138\uc694.\\n\\n\uc2dc\uc791 \uc704\uce58\ub85c \ub3cc\uc544\uac00 \ub2e4\ub978 \ucabd\uc73c\ub85c \uc6b4\ub3d9\uc744 \ubc18\ubcf5\ud558\uc138\uc694.","tips":[{"type":10,"text":"\ub9e4\ud2b8\ub97c \uc900\ube44\ud558\uc138\uc694."},{"type":0,"text":"\ud5c8\ub9ac\ub97c \ubc14\ub2e5\uc5d0 \ud3c9\ud3c9\ud558\uac8c \uc720\uc9c0\ud558\uc138\uc694."},{"type":0,"text":"\ubaa9\uc5d0 \ubb34\ub9ac\uac00 \uac00\uba74 \uc548\ub429\ub2c8\ub2e4."},{"type":4,"text":"\ub2e4\ub9ac\ub97c \uc62c\ub9ac\uba70 \uc228\uc744 \ub0b4\uc26c\uace0 \ub0b4\ub9ac\uba70 \uc228\uc744 \ub4e4\uc774 \ub9c8\uc2dc\uc138\uc694."},{"type":0,"text":"\ub108\ubb34 \uc5b4\ub835\uac8c \ub290\uaef4\uc9c0\uba74 \uc190\uc73c\ub85c \ubc18\ub300\ud3b8 \ubb34\ub98e\uc744 \ud130\uce58\ud558\uc138\uc694."},{"type":0,"text":"\ubcf5\uc9c1\uadfc\uacfc \uc0ac\uadfc\uc774 \ud0c0\ub294 \ub4ef\uc774 \ub290\uaef4\uc838\uc57c \ud569\ub2c8\ub2e4."},{"type":2,"text":"\uc774 \uc6b4\ub3d9\uc740 \ubcf5\uc9c1\uadfc\uacfc \uc0ac\uadfc\uc5d0 \uc88b\uc2b5\ub2c8\ub2e4."}]}